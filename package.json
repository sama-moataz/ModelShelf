{
  "name": "modelshelf",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --ignore-lock",
    "prebuild": "node scripts/generate-llms.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "start": "astro dev --host 0.0.0.0 --port ${PORT:-4321}",
    "check": "astro check && node scripts/generate-llms.mjs --check",
    "llms": "node scripts/generate-llms.mjs",
    "test": "node --test tests/data.test.mjs",
    "test:dist": "node --test tests/dist.test.mjs",
    "verify": "npm run check && npm test && npm run build && npm run test:dist",
    "links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@tailwindcss/vite": "^4.3.5",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.4.13",
    "lucide-astro": "^0.556.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3"
  }
}
