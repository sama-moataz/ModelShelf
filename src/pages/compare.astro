---
import Layout from '../layouts/Layout.astro';
import VerifiedBadge from '../components/VerifiedBadge.astro';
import { CATEGORIES, HARDWARE_TIERS, entries } from '../data/directoryData';
import { hardwareHub } from '../data/hubs';
import { SITE_NAME } from '../config/site';
import { entriesIn, entryPath, formatSize } from '../utils/format';
import { abs, breadcrumbs, itemList } from '../utils/seo';

const title = `Compare ${entries.length} free ML datasets and APIs side by side`;
const description = `One table comparing ${entries.length} open datasets and free APIs by modality, size, sample count, hardware tier, time to baseline and license.`;
const jsonLd = [
  { '@type': 'CollectionPage', name: title, description, url: abs('/compare/'), mainEntity: itemList(title, entries) },
  breadcrumbs([[SITE_NAME, '/'], ['Compare', '/compare/']]),
];
const tierTone: Record<string, string> = {
  'laptop-cpu': 'bg-emerald-50 text-emerald-800 ring-emerald-600/20',
  'free-colab-t4': 'bg-amber-50 text-amber-800 ring-amber-600/20',
  'needs-gpu-subset': 'bg-rose-50 text-rose-800 ring-rose-600/20',
};
---
<Layout title={title} description={description} jsonLd={jsonLd}>
  <div class="mx-auto max-w-7xl px-4 py-12">
    <nav aria-label="Breadcrumb" class="text-sm text-slate-500"><a class="hover:text-brand-700" href="/">Directory</a> / <span class="text-slate-700">Compare</span></nav>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{title}</h1>
    <p class="mt-3 max-w-3xl text-lg text-slate-600">Pick a dataset or API by what your machine can handle and what your license allows. Hardware tiers link to tuning guides; every name links to the full page with starter code and a leakage checklist.</p>
    <div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
      <VerifiedBadge />
      {Object.entries(HARDWARE_TIERS).map(([id, t]) => (
        <a href={`/hardware/${hardwareHub(id as keyof typeof HARDWARE_TIERS).slug}/`} class:list={['rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset hover:underline', tierTone[id]]}>{t.label}</a>
      ))}
    </div>

    <div class="mt-8 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm" role="region" aria-labelledby="cmp-caption" tabindex="0">
      <table class="min-w-[960px] w-full border-collapse text-left text-sm">
        <caption id="cmp-caption" class="sr-only">{title}</caption>
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-600">
          <tr>
            <th scope="col" class="sticky left-0 z-10 bg-slate-50 px-4 py-3 font-semibold">Name</th>
            <th scope="col" class="px-4 py-3 font-semibold">Modality</th>
            <th scope="col" class="px-4 py-3 font-semibold">Size</th>
            <th scope="col" class="px-4 py-3 font-semibold">Sample count</th>
            <th scope="col" class="px-4 py-3 font-semibold">Hardware tier</th>
            <th scope="col" class="px-4 py-3 font-semibold">Time to baseline</th>
            <th scope="col" class="px-4 py-3 font-semibold">License</th>
          </tr>
        </thead>
        {CATEGORIES.map((c) => (
          <tbody class="divide-y divide-slate-100 border-t border-slate-200">
            <tr class="bg-slate-50/60">
              <th scope="colgroup" colspan="7" class="sticky left-0 px-4 py-2 text-xs font-semibold uppercase tracking-wide text-slate-500">
                <a class="hover:text-brand-700" href={`/categories/${c.id}/`}>{c.name}</a>
              </th>
            </tr>
            {entriesIn(c.id).map((e) => (
              <tr class="hover:bg-brand-50/40">
                <th scope="row" class="sticky left-0 bg-white px-4 py-3 font-semibold">
                  <a class="text-brand-700 hover:underline" href={entryPath(e)}>{e.name}</a>
                  <span class="block text-xs font-normal text-slate-500">{e.kind === 'api' ? 'API' : 'Dataset'}</span>
                </th>
                <td class="px-4 py-3 text-slate-700">{c.short}</td>
                <td class="whitespace-nowrap px-4 py-3 text-slate-700">{e.sizeMB !== undefined ? formatSize(e.sizeMB) : '—'}</td>
                <td class="px-4 py-3 text-slate-700">{e.samples}</td>
                <td class="px-4 py-3"><a href={`/hardware/${hardwareHub(e.hardware).slug}/`} class:list={['inline-block whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset hover:underline', tierTone[e.hardware]]}>{HARDWARE_TIERS[e.hardware].short}</a></td>
                <td class="px-4 py-3 text-slate-700">{e.timeToBaseline}</td>
                <td class="max-w-[16rem] px-4 py-3 text-slate-700">{e.licenseUrl ? <a class="hover:text-brand-700 hover:underline" href={e.licenseUrl} rel="noopener license">{e.license}</a> : e.license}</td>
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
    <p class="mt-3 text-xs text-slate-500">Sizes and times are approximate. Licenses and free-tier limits change, so confirm on each provider's page before you ship.</p>
  </div>
</Layout>
