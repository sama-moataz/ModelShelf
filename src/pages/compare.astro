---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { CATEGORIES, HARDWARE_TIERS, PRICING, entries } from '../data/directoryData';
import { hardwareHub } from '../data/hubs';
import { directoryAtAGlance } from '../data/guides';
import { SITE_NAME } from '../config/site';
import { entriesIn, entryPath, signupShort, sizeLabel } from '../utils/format';
import { WEBSITE_ID, abs, breadcrumbs, itemList } from '../utils/seo';

const title = `Compare ${entries.length} ML datasets and APIs side by side`;
const description = `One table comparing ${entries.length} open datasets and APIs by size, sample count, hardware tier, time to baseline, access, cost and license.`;
const glance = directoryAtAGlance();
const trail: [string, string][] = [[SITE_NAME, '/'], ['Compare', '/compare/']];
const jsonLd = [
  { '@type': 'CollectionPage', name: title, description, url: abs('/compare/'), isPartOf: { '@type': 'WebSite', '@id': WEBSITE_ID, name: SITE_NAME, url: abs('/') }, mainEntity: itemList(title, entries) },
  breadcrumbs(trail),
];
const tierTone: Record<string, string> = {
  'laptop-cpu': 'text-emerald-800',
  'free-colab-t4': 'text-amber-800',
  'needs-gpu-subset': 'text-rose-800',
};
---
<Layout title={title} description={description} jsonLd={jsonLd}>
  <div class="mx-auto max-w-7xl px-4 py-12">
    <PageHeader trail={trail} title={title} lead={`Pick by hardware first, then check access, cost and license. ${glance.cost}`}>
      <p class="mt-3 max-w-3xl text-sm text-slate-600">
        Hardware tiers:{' '}
        {Object.entries(HARDWARE_TIERS).map(([id, t], i) => (
          <>{i > 0 && ' · '}<a href={`/hardware/${hardwareHub(id as keyof typeof HARDWARE_TIERS).slug}/`} class:list={['font-medium hover:underline', tierTone[id]]}>{t.label}</a> ({entries.filter((e) => e.hardware === id).length})</>
        ))}
        . {glance.hostedNote} Every name links to the full page with starter code and a leakage checklist.
      </p>
    </PageHeader>

    <h2 id="table-h" class="section-title mt-10">All {entries.length} resources side by side</h2>
    <div class="mt-4 overflow-x-auto rounded-xl border border-slate-200 bg-panel" role="region" aria-labelledby="cmp-caption" tabindex="0">
      <table class="min-w-[1080px] w-full border-collapse text-left text-sm">
        <caption id="cmp-caption" class="sr-only">{title}</caption>
        <thead class="bg-slate-50 text-xs text-slate-600">
          <tr>
            <th scope="col" class="sticky left-0 z-10 bg-slate-50 px-4 py-3 font-semibold">Name</th>
            <th scope="col" class="px-4 py-3 font-semibold">Size</th>
            <th scope="col" class="px-4 py-3 font-semibold">Samples</th>
            <th scope="col" class="px-4 py-3 font-semibold">Hardware</th>
            <th scope="col" class="px-4 py-3 font-semibold">Time to baseline</th>
            <th scope="col" class="px-4 py-3 font-semibold">Access</th>
            <th scope="col" class="px-4 py-3 font-semibold">Cost</th>
            <th scope="col" class="px-4 py-3 font-semibold">License</th>
          </tr>
        </thead>
        {CATEGORIES.map((c) => (
          <tbody class="divide-y divide-slate-100 border-t border-slate-200">
            <tr class="bg-slate-50/60">
              <th scope="colgroup" colspan="8" class="sticky left-0 px-4 py-2 text-xs text-slate-500">
                <a class="hover:text-brand-700" href={`/categories/${c.id}/`}>{c.name}</a>
              </th>
            </tr>
            {entriesIn(c.id).map((e) => (
              <tr class="hover:bg-brand-50/40">
                <th scope="row" class="sticky left-0 bg-panel px-4 py-3 font-semibold">
                  <a class="text-brand-700 hover:underline" href={entryPath(e)}>{e.name}</a>
                  <span class="block text-xs font-normal text-slate-500">{e.kind === 'api' ? 'API' : 'Dataset'}</span>
                </th>
                <td class="px-4 py-3 text-slate-700">{sizeLabel(e) || '—'}</td>
                <td class="px-4 py-3 text-slate-700">{e.samples}</td>
                <td class="px-4 py-3"><a href={`/hardware/${hardwareHub(e.hardware).slug}/`} class:list={['whitespace-nowrap font-medium hover:underline', tierTone[e.hardware]]}>{HARDWARE_TIERS[e.hardware].short}</a></td>
                <td class="px-4 py-3 text-slate-700">{e.timeToBaseline}</td>
                <td class:list={['px-4 py-3', e.pricing === 'pay-as-you-go' ? 'text-amber-800' : 'text-slate-700']}>{signupShort(e)}</td>
                <td class:list={['whitespace-nowrap px-4 py-3', e.pricing === 'pay-as-you-go' ? 'text-amber-800' : 'text-slate-700']}>{PRICING[e.pricing].short}</td>
                <td class="max-w-[16rem] px-4 py-3 text-slate-700">{e.licenseUrl ? <a class="hover:text-brand-700 hover:underline" href={e.licenseUrl} rel="noopener license">{e.license}</a> : e.license}</td>
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
    <p class="meta-note mt-3">Sizes and times are approximate. Licenses and free-tier limits change, so confirm on each provider's page before you ship.</p>
  </div>
</Layout>
