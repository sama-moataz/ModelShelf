---
// Intent landing pages at the site root. Copy lives in src/data/landings.ts; every fact
// about a resource (license, size, access, hardware) is read from the directory data.
import Layout from '../layouts/Layout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import EntryTable from '../components/EntryTable.astro';
import VerifiedBadge from '../components/VerifiedBadge.astro';
import ArrowRight from 'lucide-astro/ArrowRight';
import TriangleAlert from 'lucide-astro/TriangleAlert';
import { HARDWARE_TIERS, PRICING } from '../data/directoryData';
import { LANDINGS, landingEntry, landingPicks, type Landing } from '../data/landings';
import { SITE_NAME } from '../config/site';
import { entryPath, richText, signupShort } from '../utils/format';
import { WEBSITE_ID, abs, breadcrumbs, itemList } from '../utils/seo';

export function getStaticPaths() {
  return LANDINGS.map((landing) => ({ params: { landing: landing.slug }, props: { landing } }));
}
interface Props { landing: Landing }
const { landing } = Astro.props;
const path = `/${landing.slug}/`;
const picks = landingPicks(landing);
const names = (list: typeof picks) => list.map((e) => `[[${e.slug}]]`).join(', ');
const commercial = picks.filter((e) => e.badges.includes('commercial-ok'));
const notCommercial = picks.filter((e) => !e.badges.includes('commercial-ok'));
const licenseLine =
  `Commercial use allowed by the license or terms: ${commercial.length ? names(commercial) : 'none of these'}.` +
  (notCommercial.length ? ` Not allowed, restricted or unclear: ${names(notCommercial)}. Each resource page quotes the exact terms.` : '');

const jsonLd = [
  {
    '@type': 'CollectionPage',
    '@id': abs(path),
    name: landing.h1,
    description: landing.metaDescription,
    url: abs(path),
    inLanguage: 'en',
    isPartOf: { '@id': WEBSITE_ID },
    mainEntity: itemList(landing.h1, picks),
  },
  breadcrumbs([[SITE_NAME, '/'], [landing.label, path]]),
];
---
<Layout title={landing.title} description={landing.metaDescription} jsonLd={jsonLd}>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:py-12">
    <nav aria-label="Breadcrumb" class="text-sm text-slate-500">
      <ol class="flex flex-wrap gap-1">
        <li><a class="hover:text-brand-700" href="/">{SITE_NAME}</a> /</li>
        <li aria-current="page" class="text-slate-700">{landing.label}</li>
      </ol>
    </nav>
    <h1 class="mt-3 max-w-3xl text-2xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{landing.h1}</h1>
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-slate-800 sm:text-lg" set:html={richText(landing.answer)} />
    <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-slate-500">
      <span>{picks.length} resources</span>
      <VerifiedBadge />
    </div>

    <section class="mt-8 max-w-3xl rounded-xl border border-slate-200 bg-panel p-5" aria-labelledby="who">
      <h2 id="who" class="text-base font-bold text-slate-900">Who this page is for</h2>
      <p class="mt-2 leading-relaxed text-slate-700">{landing.audience}</p>
      <p class="mt-3 text-xs text-slate-500">{landing.rule.text}</p>
    </section>

    {landing.groups.map((g, gi) => (
      <section class="mt-10" aria-labelledby={`g${gi}`}>
        <h2 id={`g${gi}`} class="text-xl font-bold text-slate-900">{g.heading}</h2>
        {g.intro && <p class="mt-1 text-slate-600">{g.intro}</p>}
        <ol class="mt-4 space-y-3">
          {g.picks.map((p) => {
            const e = landingEntry(p.slug);
            return (
              <li class="rounded-xl border border-slate-200 bg-panel p-4 transition-colors hover:border-brand-400 sm:p-5">
                <h3 class="text-base font-bold text-slate-900"><a class="hover:text-brand-700" href={entryPath(e)}>{e.name}</a></h3>
                <p class="mt-1.5 leading-relaxed text-slate-700" set:html={richText(p.why)} />
                <dl class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs">
                  <div class="flex gap-1.5"><dt class="text-syn-prop">hardware</dt><dd class="text-slate-700">{HARDWARE_TIERS[e.hardware].label}</dd></div>
                  <div class="flex gap-1.5"><dt class="text-syn-prop">sign-up</dt><dd class="text-slate-700">{signupShort(e)}</dd></div>
                  <div class="flex gap-1.5"><dt class="text-syn-prop">cost</dt><dd class="text-slate-700">{PRICING[e.pricing].short}</dd></div>
                  <div class="flex min-w-0 gap-1.5"><dt class="text-syn-prop">license</dt><dd class="break-words text-slate-700">{e.license}</dd></div>
                </dl>
              </li>
            );
          })}
        </ol>
      </section>
    ))}

    <section class="mt-12" aria-labelledby="glance">
      <h2 id="glance" class="text-xl font-bold text-slate-900">At a glance</h2>
      <p class="mt-1 text-sm text-slate-600">Task, size, sign-up, hardware and license for all {picks.length}. The table scrolls sideways on small screens.</p>
      <div class="mt-4"><EntryTable list={picks} caption={`${landing.h1}: key facts`} /></div>
    </section>

    <section class="mt-12 max-w-3xl" aria-labelledby="notes">
      <h2 id="notes" class="text-xl font-bold text-slate-900">Access, hardware and licenses</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed text-slate-700">
        {landing.considerations.map((c) => <li set:html={richText(c)} />)}
        <li set:html={richText(licenseLine)} />
      </ul>
    </section>

    {landing.snippet && (
      <section class="mt-12 max-w-3xl" aria-labelledby="code">
        <h2 id="code" class="text-xl font-bold text-slate-900">{landing.snippet.title}</h2>
        <p class="mt-1 mb-3 text-slate-600">{landing.snippet.caption}</p>
        <CodeBlock snippet={landing.snippet} file={`${landing.slug.split('-').slice(0, 2).join('_')}.${{ python: 'py', bash: 'sh', javascript: 'js' }[landing.snippet.lang]}`} />
      </section>
    )}

    <div class="mt-12 grid max-w-5xl gap-8 md:grid-cols-2">
      <section aria-labelledby="ideas">
        <h2 id="ideas" class="text-xl font-bold text-slate-900">What you could build</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed text-slate-700">{landing.ideas.map((i) => <li set:html={richText(i)} />)}</ul>
      </section>
      <section aria-labelledby="mistakes">
        <h2 id="mistakes" class="flex items-center gap-2 text-xl font-bold text-slate-900"><TriangleAlert size={18} aria-hidden="true" class="text-amber-600" /> Common mistakes</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed text-slate-700">{landing.mistakes.map((m) => <li set:html={richText(m)} />)}</ul>
      </section>
    </div>

    <nav class="mt-12" aria-labelledby="next">
      <h2 id="next" class="text-xl font-bold text-slate-900">Next step</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-3">
        {landing.nextSteps.map((s, i) => (
          <li>
            <a href={s.href} class:list={['group flex h-full items-start justify-between gap-3 rounded-xl border p-4 transition-colors', i === 0 ? 'border-brand-500 bg-brand-50 hover:border-brand-400' : 'border-slate-200 bg-panel hover:border-brand-400']}>
              <span><span class="block font-semibold text-slate-900 group-hover:text-brand-700">{s.label}</span><span class="mt-1 block text-sm text-slate-600">{s.note}</span></span>
              <ArrowRight size={16} aria-hidden="true" class="mt-1 shrink-0 text-brand-700" />
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="mt-12 border-t border-slate-200 pt-6 text-sm" aria-label="Other starting points">
      <p class="text-slate-500">Other starting points</p>
      <ul class="mt-2 flex flex-wrap gap-2">
        {LANDINGS.filter((l) => l.slug !== landing.slug).map((l) => (
          <li><a class="inline-flex min-h-9 items-center rounded-md border border-slate-300 px-3 py-1 text-slate-700 hover:border-brand-400 hover:text-brand-700" href={`/${l.slug}/`}>{l.label}</a></li>
        ))}
        <li><a class="inline-flex min-h-9 items-center rounded-md border border-slate-300 px-3 py-1 text-slate-700 hover:border-brand-400 hover:text-brand-700" href="/guides/">All guides</a></li>
      </ul>
    </nav>
  </div>
</Layout>
