---
// Intent landing pages at the site root. Copy lives in src/data/landings.ts; every fact
// about a resource (license, size, access, hardware) is read from the directory data.
import Layout from '../layouts/Layout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import PageHeader from '../components/PageHeader.astro';
import ArrowRight from 'lucide-astro/ArrowRight';
import { HARDWARE_TIERS, PRICING, type Entry } from '../data/directoryData';
import { LANDINGS, landingEntry, landingPicks, type Landing } from '../data/landings';
import { SITE_NAME } from '../config/site';
import { entryPath, richText, signupShort, sizeLabel } from '../utils/format';
import { WEBSITE_ID, abs, breadcrumbs, itemList } from '../utils/seo';

export function getStaticPaths() {
  return LANDINGS.map((landing) => ({ params: { landing: landing.slug }, props: { landing } }));
}
interface Props { landing: Landing }
const { landing } = Astro.props;
const path = `/${landing.slug}/`;
const picks = landingPicks(landing);
const names = (list: typeof picks) => list.map((e) => `[[${e.slug}]]`).join(', ');
const commercial = picks.filter((e) => e.badges.includes('commercial-ok'));
const notCommercial = picks.filter((e) => !e.badges.includes('commercial-ok'));
const licenseLine =
  `Commercial use allowed by the license or terms: ${commercial.length ? names(commercial) : 'none of these'}.` +
  (notCommercial.length ? ` Not allowed, restricted or unclear: ${names(notCommercial)}. Each resource page quotes the exact terms.` : '');

const trail: [string, string][] = [[SITE_NAME, '/'], [landing.label, path]];
// The same facts, in the same order, as the access/size/license rows on resource cards, plus hardware.
const pickFacts = (e: Entry): [string, string, boolean?][] => [
  ['access', signupShort(e), e.pricing === 'pay-as-you-go'],
  e.sizeMB !== undefined ? ['size', sizeLabel(e)] : ['cost', PRICING[e.pricing].short, e.pricing === 'pay-as-you-go'],
  ['hardware', HARDWARE_TIERS[e.hardware].label],
  ['license', e.license],
];
const jsonLd = [
  {
    '@type': 'CollectionPage',
    '@id': abs(path),
    name: landing.h1,
    description: landing.metaDescription,
    url: abs(path),
    inLanguage: 'en',
    isPartOf: { '@id': WEBSITE_ID },
    mainEntity: itemList(landing.h1, picks),
  },
  breadcrumbs(trail),
];
---
<Layout title={landing.title} description={landing.metaDescription} jsonLd={jsonLd}>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:py-12">
    <PageHeader trail={trail} title={landing.h1} lead={landing.answer} />

    <section class="mt-8 max-w-3xl" aria-labelledby="who">
      <h2 id="who" class="section-title">Who this page is for</h2>
      <p class="mt-2 leading-relaxed text-slate-700">{landing.audience}</p>
      <p class="meta-note mt-2">{landing.rule.text}</p>
    </section>

    {landing.groups.map((g, gi) => (
      <section class="mt-10" aria-labelledby={`g${gi}`}>
        <h2 id={`g${gi}`} class="section-title">{g.heading}</h2>
        {g.intro && <p class="section-lead">{g.intro}</p>}
        <ol class="mt-4 space-y-3">
          {g.picks.map((p) => {
            const e = landingEntry(p.slug);
            return (
              <li class="rounded-xl border border-slate-200 bg-panel p-4 transition-colors hover:border-brand-400 sm:p-5">
                <h3 class="text-base font-bold text-slate-900"><a class="hover:text-brand-700" href={entryPath(e)}>{e.name}</a></h3>
                <p class="mt-1.5 leading-relaxed text-slate-700" set:html={richText(p.why)} />
                <dl class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs">
                  {pickFacts(e).map(([k, v, warn]) => (
                    <div class="flex min-w-0 gap-1.5"><dt class="text-syn-prop">{k}</dt><dd class:list={['break-words', warn ? 'font-medium text-amber-800' : 'text-slate-700']}>{v}</dd></div>
                  ))}
                </dl>
              </li>
            );
          })}
        </ol>
      </section>
    ))}

    <section class="mt-12 max-w-3xl" aria-labelledby="notes">
      <h2 id="notes" class="section-title">Access, hardware and licenses</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed text-slate-700">
        {landing.considerations.map((c) => <li set:html={richText(c)} />)}
        <li set:html={richText(licenseLine)} />
      </ul>
    </section>

    {landing.snippet && (
      <section class="mt-12 max-w-3xl" aria-labelledby="code">
        <h2 id="code" class="section-title">{landing.snippet.title}</h2>
        <p class="section-lead mb-3">{landing.snippet.caption}</p>
        <CodeBlock snippet={landing.snippet} file={`${landing.slug.split('-').slice(0, 2).join('_')}.${{ python: 'py', bash: 'sh', javascript: 'js' }[landing.snippet.lang]}`} />
      </section>
    )}

    <div class="mt-12 grid max-w-5xl gap-8 md:grid-cols-2">
      <section aria-labelledby="ideas">
        <h2 id="ideas" class="section-title">What you could build</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed text-slate-700">{landing.ideas.map((i) => <li set:html={richText(i)} />)}</ul>
      </section>
      <section aria-labelledby="mistakes">
        <h2 id="mistakes" class="section-title">Common mistakes</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed text-slate-700">{landing.mistakes.map((m) => <li set:html={richText(m)} />)}</ul>
      </section>
    </div>

    <nav class="mt-12" aria-labelledby="next">
      <h2 id="next" class="section-title">Next step</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-3">
        {landing.nextSteps.map((s) => (
          <li>
            <a href={s.href} class="link-card group">
              <span><span class="block font-semibold text-slate-900 group-hover:text-brand-700">{s.label}</span><span class="mt-1 block text-sm text-slate-600">{s.note}</span></span>
              <ArrowRight size={16} aria-hidden="true" class="mt-1 shrink-0 text-brand-700" />
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="mt-12 border-t border-slate-200 pt-6 text-sm" aria-label="Other starting points">
      <p class="text-slate-500">Other starting points</p>
      <ul class="mt-2 flex flex-wrap gap-2">
        {LANDINGS.filter((l) => l.slug !== landing.slug).map((l) => (
          <li><a class="chip-link" href={`/${l.slug}/`}>{l.label}</a></li>
        ))}
        <li><a class="chip-link" href="/guides/">All guides</a></li>
      </ul>
    </nav>
  </div>
</Layout>
