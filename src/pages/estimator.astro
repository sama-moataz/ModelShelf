---
import Layout from '../layouts/Layout.astro';
import { entries } from '../data/directoryData';
import { formatSize } from '../utils/format';
import { SITE_NAME } from '../config/site';
import { breadcrumbs } from '../utils/seo';
const jsonLd = [breadcrumbs([[SITE_NAME, '/'], ['Estimator', '/estimator/']])];

const apis = entries.filter((e) => e.quotas?.length).map((e) => ({ slug: e.slug, name: e.name, quotas: e.quotas }));
const sets = entries.filter((e) => e.sizeMB !== undefined).map((e) => ({ slug: e.slug, name: e.name, sizeMB: e.sizeMB, size: formatSize(e.sizeMB) }));
---
<Layout title="Free-tier estimator: will it fit your project?" description="Check whether an API's free tier covers your expected traffic, and whether a dataset fits your laptop's disk and memory." jsonLd={jsonLd}>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav aria-label="Breadcrumb" class="text-sm text-slate-500">
      <ol class="flex flex-wrap gap-1">
        <li><a class="hover:text-brand-700" href="/">{SITE_NAME}</a> /</li>
        <li aria-current="page" class="text-slate-700">Estimator</li>
      </ol>
    </nav>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Free-tier estimator</h1>
    <p class="mt-2 text-slate-600">Check an API's daily allowance against your expected traffic, or a dataset against your hardware. Figures are approximate and use the limits listed on each resource page. Only APIs that publish a daily limit are listed; for Groq and Gemini, your limits are shown in their consoles.</p>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <form id="api-form" class="rounded-xl border border-slate-200 bg-panel p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-slate-900">API quota</h2>
        <label class="mt-4 block text-sm font-medium" for="api">API</label>
        <select id="api" class="mt-1 min-h-10 w-full rounded-lg border border-slate-300 bg-panel px-3 py-2 text-sm">
          {apis.map((a) => <option value={a.slug}>{a.name}</option>)}
        </select>
        <label class="mt-3 block text-sm font-medium" for="tier">Tier</label>
        <select id="tier" class="mt-1 min-h-10 w-full rounded-lg border border-slate-300 bg-panel px-3 py-2 text-sm"></select>
        <label class="mt-3 block text-sm font-medium" for="users">Users per day</label>
        <input id="users" type="number" inputmode="numeric" min="0" step="1" value="20" class="mt-1 min-h-10 w-full rounded-lg border border-slate-300 px-3 py-2 text-base sm:text-sm" />
        <label class="mt-3 block text-sm font-medium" for="calls">API calls per user</label>
        <input id="calls" type="number" inputmode="numeric" min="0" step="1" value="5" class="mt-1 min-h-10 w-full rounded-lg border border-slate-300 px-3 py-2 text-base sm:text-sm" />
        <div id="api-out" class="mt-5 rounded-lg p-4 text-sm" aria-live="polite"></div>
      </form>

      <form id="data-form" class="rounded-xl border border-slate-200 bg-panel p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-slate-900">Dataset on your machine</h2>
        <label class="mt-4 block text-sm font-medium" for="set">Dataset</label>
        <select id="set" class="mt-1 min-h-10 w-full rounded-lg border border-slate-300 bg-panel px-3 py-2 text-sm">
          {sets.map((s) => <option value={s.slug}>{s.name} ({s.size})</option>)}
        </select>
        <label class="mt-3 block text-sm font-medium" for="disk">Free disk space (GB)</label>
        <input id="disk" type="number" inputmode="decimal" min="0" step="0.5" value="20" class="mt-1 min-h-10 w-full rounded-lg border border-slate-300 px-3 py-2 text-base sm:text-sm" />
        <label class="mt-3 block text-sm font-medium" for="ram">RAM (GB)</label>
        <input id="ram" type="number" inputmode="decimal" min="0" step="0.5" value="8" class="mt-1 min-h-10 w-full rounded-lg border border-slate-300 px-3 py-2 text-base sm:text-sm" />
        <div id="data-out" class="mt-5 rounded-lg p-4 text-sm" aria-live="polite"></div>
      </form>
    </div>
    <p class="mt-6 text-xs text-slate-500">Rules of thumb: downloads need about 2x their size on disk (archive plus extracted files), and loading a dataset fully into memory needs about 2x its size in RAM.</p>
  </div>
  <script id="est-data" type="application/json" set:html={JSON.stringify({ apis, sets })} />
</Layout>

<script>
  const { apis, sets } = JSON.parse(document.getElementById('est-data')!.textContent!);
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const fmt = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 1 });
  /** A number from an input, or null when it is empty or not a valid non-negative number. */
  const num = (id: string) => {
    const el = $<HTMLInputElement>(id);
    const v = el.value.trim() === '' ? NaN : Number(el.value);
    const ok = Number.isFinite(v) && v >= 0;
    el.setAttribute('aria-invalid', String(!ok));
    return ok ? v : null;
  };
  const paint = (el: HTMLElement, ok: boolean | null, html: string) => {
    el.className = `mt-5 rounded-lg p-4 text-sm ${ok === null ? 'bg-slate-50 text-slate-700' : ok ? 'bg-emerald-50 text-emerald-900' : 'bg-amber-50 text-amber-900'}`;
    el.innerHTML = html;
  };

  const api = $<HTMLSelectElement>('api'), tier = $<HTMLSelectElement>('tier');
  function fillTiers() {
    const a = apis.find((x: any) => x.slug === api.value);
    tier.innerHTML = a.quotas.map((q: any, i: number) => `<option value="${i}">${q.label}: ${fmt(q.perDay)}/day</option>`).join('');
  }
  function runApi() {
    const a = apis.find((x: any) => x.slug === api.value);
    const quota = a.quotas[Number(tier.value)]?.perDay ?? 0;
    const users = num('users'), calls = num('calls');
    if (users === null || calls === null) return paint($('api-out'), null, 'Enter users per day and API calls per user as whole numbers of 0 or more.');
    const need = users * calls;
    const pct = quota ? (need / quota) * 100 : 0;
    const perUser = calls ? Math.floor(quota / calls) : 0;
    paint($('api-out'), need <= quota,
      `<strong>${need <= quota ? 'Fits' : 'Over the free limit'}</strong>: you need ${fmt(need)} calls/day against ${fmt(quota)} allowed (${fmt(pct)}%).` +
      (calls ? ` The free tier supports about ${fmt(perUser)} users/day at ${fmt(calls)} calls each.` : '') +
      (need > quota ? ' Cache responses, batch requests, or move to a higher tier.' : ''));
  }
  function runData() {
    const s = sets.find((x: any) => x.slug === $<HTMLSelectElement>('set').value);
    const diskGB = num('disk'), ramGB = num('ram');
    if (diskGB === null || ramGB === null) return paint($('data-out'), null, 'Enter free disk space and RAM in GB, as numbers of 0 or more.');
    const disk = diskGB * 1024, ram = ramGB * 1024;
    const diskOk = s.sizeMB * 2 <= disk, ramOk = s.sizeMB * 2 <= ram;
    paint($('data-out'), diskOk && ramOk,
      `<strong>${s.name}</strong> is ${s.size}.<br>Disk: ${diskOk ? 'fits' : 'needs more space'} (needs about ${fmt((s.sizeMB * 2) / 1024)} GB).<br>` +
      `In memory: ${ramOk ? 'fits' : 'too big to load fully; stream it or use a subset'}.`);
  }

  const set = $<HTMLSelectElement>('set');
  // The fragment names the resource last picked, so a copied link reopens it. replaceState adds no
  // history entry, so Back still leaves the page instead of stepping through every selection.
  const remember = (slug: string) => history.replaceState(null, '', `${location.pathname}#entry=${encodeURIComponent(slug)}`);
  api.addEventListener('change', () => { fillTiers(); runApi(); remember(api.value); });
  set.addEventListener('change', () => remember(set.value));
  $('api-form').addEventListener('input', runApi);
  $('data-form').addEventListener('input', runData);
  for (const f of ['api-form', 'data-form']) $(f).addEventListener('submit', (ev) => ev.preventDefault());

  /** Select the resource named in #entry= (or the older ?entry=), then recompute. */
  function fromUrl() {
    const want = new URLSearchParams(location.hash.slice(1)).get('entry') ?? new URLSearchParams(location.search).get('entry');
    if (want && apis.some((a: any) => a.slug === want)) api.value = want;
    if (want && sets.some((s: any) => s.slug === want)) set.value = want;
    fillTiers(); runApi(); runData();
  }
  // Older links used ?entry=<slug>; fold it into the fragment so the address bar shows the canonical /estimator/.
  const fromQuery = new URLSearchParams(location.search).get('entry');
  if (fromQuery) remember(fromQuery);
  fromUrl();
  window.addEventListener('hashchange', fromUrl);
</script>
