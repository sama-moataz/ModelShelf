---
import Layout from '../../layouts/Layout.astro';
import EntryCard from '../../components/EntryCard.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import VerifiedBadge from '../../components/VerifiedBadge.astro';
import ArrowRight from 'lucide-astro/ArrowRight';
import { CATEGORIES, entries, type Category } from '../../data/directoryData';
import { CATEGORY_GUIDES } from '../../data/guides';
import { SITE_NAME } from '../../config/site';
import { entriesIn, entryPath, lowerFirst } from '../../utils/format';
import { WEBSITE_ID, abs, breadcrumbs, itemList } from '../../utils/seo';

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { id: category.id }, props: { category } }));
}
interface Props { category: Category }
const { category } = Astro.props;
const list = entriesIn(category.id);
const guide = CATEGORY_GUIDES[category.id];
const starter = entries.find((e) => e.slug === guide.firstProject.slug)!;
// "Free LLM & model APIs" -> "Free LLM & Model APIs"
const titleName = category.name.replace(/\b[a-z]/g, (c) => c.toUpperCase());
const path = `/categories/${category.id}/`;
const jsonLd = [
  { '@type': 'CollectionPage', name: category.name, description: category.blurb, url: abs(path), isPartOf: { '@type': 'WebSite', '@id': WEBSITE_ID, name: SITE_NAME, url: abs('/') }, mainEntity: itemList(category.name, list) },
  breadcrumbs([[SITE_NAME, '/'], ['Categories', '/categories/'], [category.name, path]]),
];
---
<Layout title={`${category.name} for AI/ML projects`} description={category.blurb} jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-4 py-12">
    <nav aria-label="Breadcrumb" class="text-sm text-slate-500">
      <ol class="flex flex-wrap gap-1">
        <li><a class="hover:text-brand-700" href="/">Directory</a> /</li>
        <li><a class="hover:text-brand-700" href="/categories/">Categories</a> /</li>
        <li aria-current="page" class="text-slate-700">{category.name}</li>
      </ol>
    </nav>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{category.name}</h1>
    <p class="mt-2 max-w-2xl text-slate-600">{category.blurb}</p>
    <div class="mt-4"><VerifiedBadge /></div>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <QuickAnswer id="when-to-choose" heading={`When to Choose ${titleName}`} answer={guide.whenToChoose.answer} points={guide.whenToChoose.picks} pointsLabel="Pick by goal" />
      <QuickAnswer id="first-project" heading="Best First Project for Beginners" answer={guide.firstProject.answer} points={guide.firstProject.steps} pointsLabel={guide.firstProject.title} ordered>
        <a href={entryPath(starter)} class="mt-5 inline-flex items-center gap-1.5 self-start rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700">
          Starter code for {starter.name} <ArrowRight size={14} aria-hidden="true" />
        </a>
      </QuickAnswer>
    </div>

    <h2 class="mt-12 text-xl font-bold text-slate-900">All {list.length} {lowerFirst(category.name)}</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{list.map((e) => <EntryCard entry={e} />)}</div>
  </div>
</Layout>
