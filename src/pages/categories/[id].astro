---
import Layout from '../../layouts/Layout.astro';
import EntryCard from '../../components/EntryCard.astro';
import { CATEGORIES, type Category } from '../../data/directoryData';
import { SITE_NAME, SITE_URL } from '../../config/site';
import { entriesIn, entryPath } from '../../utils/format';

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { id: category.id }, props: { category } }));
}
interface Props { category: Category }
const { category } = Astro.props;
const list = entriesIn(category.id);
const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: category.name,
    description: category.blurb,
    mainEntity: { '@type': 'ItemList', itemListElement: list.map((e, i) => ({ '@type': 'ListItem', position: i + 1, name: e.name, url: new URL(entryPath(e), SITE_URL).href })) },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE_NAME, item: SITE_URL + '/' },
      { '@type': 'ListItem', position: 2, name: 'Categories', item: new URL('/categories/', SITE_URL).href },
      { '@type': 'ListItem', position: 3, name: category.name, item: new URL(`/categories/${category.id}/`, SITE_URL).href },
    ],
  },
];
---
<Layout title={`${category.name} for AI/ML projects`} description={category.blurb} jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-4 py-12">
    <nav aria-label="Breadcrumb" class="text-sm text-slate-500"><a class="hover:text-brand-700" href="/categories/">Categories</a> / {category.name}</nav>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{category.name}</h1>
    <p class="mt-2 max-w-2xl text-slate-600">{category.blurb}</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{list.map((e) => <EntryCard entry={e} />)}</div>
  </div>
</Layout>
