---
import Layout from '../../layouts/Layout.astro';
import EntryCard from '../../components/EntryCard.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import PageHeader from '../../components/PageHeader.astro';
import ArrowRight from 'lucide-astro/ArrowRight';
import { CATEGORIES, entries, type Category } from '../../data/directoryData';
import { CATEGORY_GUIDES } from '../../data/guides';
import { SITE_NAME } from '../../config/site';
import { entriesIn, entryPath, lowerFirst } from '../../utils/format';
import { WEBSITE_ID, abs, breadcrumbs, itemList } from '../../utils/seo';

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { id: category.id }, props: { category } }));
}
interface Props { category: Category }
const { category } = Astro.props;
const list = entriesIn(category.id);
const guide = CATEGORY_GUIDES[category.id];
const starter = entries.find((e) => e.slug === guide.firstProject.slug)!;
const path = `/categories/${category.id}/`;
const trail: [string, string][] = [[SITE_NAME, '/'], ['Categories', '/categories/'], [category.name, path]];
const jsonLd = [
  { '@type': 'CollectionPage', name: category.name, description: category.blurb, url: abs(path), isPartOf: { '@type': 'WebSite', '@id': WEBSITE_ID, name: SITE_NAME, url: abs('/') }, mainEntity: itemList(category.name, list) },
  breadcrumbs(trail),
];
---
<Layout title={`${category.name} for AI/ML projects`} description={category.blurb} jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:py-12">
    <PageHeader trail={trail} title={category.name} lead={category.blurb} />

    <div class="mt-8 grid gap-4 lg:grid-cols-2">
      <QuickAnswer id="when-to-choose" heading={`When to choose ${lowerFirst(category.name)}`} answer={guide.whenToChoose.answer} points={guide.whenToChoose.picks} pointsLabel="Pick by goal" />
      <QuickAnswer id="first-project" heading="Best first project for beginners" answer={guide.firstProject.answer} points={guide.firstProject.steps} pointsLabel={guide.firstProject.title} ordered>
        <a href={entryPath(starter)} class="btn-primary mt-5 self-start">
          Starter code for {starter.name} <ArrowRight size={14} aria-hidden="true" />
        </a>
      </QuickAnswer>
    </div>

    <h2 class="section-title mt-12">All {list.length} {lowerFirst(category.name)}</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{list.map((e) => <EntryCard entry={e} />)}</div>
  </div>
</Layout>
