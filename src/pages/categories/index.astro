---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { CATEGORIES, entries } from '../../data/directoryData';
import { entriesIn } from '../../utils/format';
import { SITE_NAME } from '../../config/site';
import { breadcrumbs } from '../../utils/seo';
const trail: [string, string][] = [[SITE_NAME, '/'], ['Categories', '/categories/']];
const jsonLd = [breadcrumbs(trail)];
const lead = `${SITE_NAME} groups its ${entries.length} resources into ${CATEGORIES.length} categories: ${CATEGORIES.map((c) => `${c.short} (${entriesIn(c.id).length})`).join(', ')}. Each category page says when to choose it and which entry makes the best first project for a beginner.`;
---
<Layout title="Categories: datasets and APIs by task" description="Browse open datasets and APIs for AI/ML by category: language, vision, tabular, audio, LLM APIs and data APIs." jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:py-12">
    <PageHeader trail={trail} title="Browse by category" lead={lead} />
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {CATEGORIES.map((c) => (
        <a href={`/categories/${c.id}/`} class="group rounded-xl border border-slate-200 bg-panel p-5 transition-colors hover:border-brand-400">
          <h2 class="text-lg font-semibold text-slate-900 group-hover:text-brand-700">{c.name}</h2>
          <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{c.description}</p>
          <p class="mt-3 text-xs text-slate-500"><span class="text-syn-num">{entriesIn(c.id).length}</span> resources</p>
        </a>
      ))}
    </div>
  </div>
</Layout>
