---
import Layout from '../../layouts/Layout.astro';
import { CATEGORIES } from '../../data/directoryData';
import { entriesIn } from '../../utils/format';
---
<Layout title="Categories: datasets and APIs by task" description="Browse open datasets and free APIs for AI/ML by category: language, vision, tabular, audio, LLM APIs and data APIs.">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Browse by category</h1>
    <p class="mt-2 max-w-2xl text-slate-600">Six areas, each hand-picked for student and indie projects.</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {CATEGORIES.map((c) => (
        <a href={`/categories/${c.id}/`} class="group rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-brand-500 hover:shadow-md">
          <p class="text-xs font-semibold uppercase tracking-wide text-brand-700">{entriesIn(c.id).length} resources</p>
          <h2 class="mt-2 text-xl font-semibold text-slate-900 group-hover:text-brand-700">{c.name}</h2>
          <p class="mt-2 text-sm text-slate-600">{c.description}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>
