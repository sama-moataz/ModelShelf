---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ArrowRight from 'lucide-astro/ArrowRight';
import { SITE_NAME } from '../../config/site';
import { LANDINGS } from '../../data/landings';
import { WEBSITE_ID, abs, breadcrumbs } from '../../utils/seo';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const title = 'Guides for Student AI and ML Projects';
const description = 'Practical guides on choosing datasets, training on a laptop or free Colab, licenses, API keys and rate limits, and local vs hosted LLMs.';
const trail: [string, string][] = [[SITE_NAME, '/'], ['Guides', '/guides/']];
const jsonLd = [
  {
    '@type': 'CollectionPage',
    '@id': abs('/guides/'),
    name: title,
    description,
    url: abs('/guides/'),
    isPartOf: { '@id': WEBSITE_ID },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: guides.length,
      itemListElement: guides.map((g, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(`/guides/${g.id}/`), name: g.data.h1 })),
    },
  },
  breadcrumbs(trail),
];
---
<Layout title={title} description={description} jsonLd={jsonLd}>
  <div class="mx-auto max-w-4xl px-4 py-10 sm:py-12">
    <PageHeader trail={trail} title="Guides for student AI and ML projects" lead="Short, practical guides to the decisions that trip students up: which dataset, which hardware, which license, and which API. Facts from primary sources are marked and linked; the rest is guidance from common practice." />

    <ol class="mt-8 space-y-3">
      {guides.map((g, i) => (
        <li>
          <a href={`/guides/${g.id}/`} class="group flex items-start gap-4 rounded-xl border border-slate-200 bg-panel p-4 transition-colors hover:border-brand-400 sm:p-5">
            <span class="mt-0.5 font-mono text-sm text-syn-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="min-w-0 flex-1">
              <span class="block font-bold text-slate-900 group-hover:text-brand-700">{g.data.h1}</span>
              <span class="mt-1 block text-sm leading-relaxed text-slate-600">{g.data.summary}</span>
            </span>
            <ArrowRight size={16} aria-hidden="true" class="mt-1 shrink-0 text-brand-700" />
          </a>
        </li>
      ))}
    </ol>

    <nav class="mt-12 border-t border-slate-200 pt-6 text-sm" aria-labelledby="start-h">
      <h2 id="start-h" class="text-sm text-slate-500">Or start from a curated list</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {LANDINGS.map((l) => <li><a class="chip-link" href={`/${l.slug}/`}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
</Layout>
