---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import EntryTable from '../../components/EntryTable.astro';
import BookOpen from 'lucide-astro/BookOpen';
import ArrowRight from 'lucide-astro/ArrowRight';
import { SITE_NAME } from '../../config/site';
import { landingEntry } from '../../data/landings';
import { longDate } from '../../utils/format';
import { ORG_ID, WEBSITE_ID, abs, breadcrumbs } from '../../utils/seo';

export async function getStaticPaths() {
  const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
  return guides.map((guide, i) => ({ params: { slug: guide.id }, props: { guide, next: guides[(i + 1) % guides.length] } }));
}
const { guide, next } = Astro.props;
const { Content, headings } = await render(guide);
const g = guide.data;
const path = `/guides/${guide.id}/`;
const resources = g.resources.map(landingEntry);
const toc = headings.filter((h) => h.depth === 2);

const jsonLd = [
  {
    '@type': 'TechArticle',
    '@id': `${abs(path)}#article`,
    headline: g.h1,
    description: g.description,
    url: abs(path),
    inLanguage: 'en',
    dateModified: g.checked,
    author: { '@id': ORG_ID },
    publisher: { '@id': ORG_ID },
    isPartOf: { '@id': WEBSITE_ID },
    mainEntityOfPage: abs(path),
    citation: g.sources.map((s) => s.url),
  },
  breadcrumbs([[SITE_NAME, '/'], ['Guides', '/guides/'], [g.title, path]]),
];
---
<Layout title={g.title} description={g.description} jsonLd={jsonLd} ogType="article">
  <article class="mx-auto max-w-3xl px-4 py-10 sm:py-12">
    <nav aria-label="Breadcrumb" class="text-sm text-slate-500">
      <ol class="flex flex-wrap gap-1">
        <li><a class="hover:text-brand-700" href="/">{SITE_NAME}</a> /</li>
        <li><a class="hover:text-brand-700" href="/guides/">Guides</a> /</li>
        <li aria-current="page" class="text-slate-700">{g.title.split(':')[0]}</li>
      </ol>
    </nav>
    <h1 class="mt-3 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{g.h1}</h1>
    <p class="mt-4 text-base leading-relaxed text-slate-800 sm:text-lg">{g.summary}</p>
    <p class="mt-4 rounded-lg border border-slate-200 bg-panel p-3 text-sm leading-relaxed text-slate-600">
      Boxes marked <strong class="text-slate-900">Checked fact</strong> quote or summarise a primary source, linked, as read on <time datetime={g.checked}>{longDate(g.checked)}</time>. Everything else is general guidance from common practice.
    </p>

    {toc.length > 2 && (
      <nav class="mt-8 rounded-xl border border-slate-200 bg-panel p-4 text-sm" aria-labelledby="toc-h">
        <p id="toc-h" class="flex items-center gap-2 font-semibold text-slate-900"><BookOpen size={15} aria-hidden="true" /> On this page</p>
        <ol class="mt-2 list-decimal pl-5 text-slate-700 marker:text-slate-500">
          {toc.map((h) => <li><a class="inline-block py-1 hover:text-brand-700 hover:underline" href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
    )}

    <div class="guide-prose mt-8"><Content /></div>

    {resources.length > 0 && (
      <section class="mt-12" aria-labelledby="mentioned">
        <h2 id="mentioned" class="text-xl font-bold text-slate-900">Resources in this guide</h2>
        <p class="mt-1 text-sm text-slate-600">Current facts from the directory, so they stay in step with each resource page.</p>
        <div class="mt-4"><EntryTable list={resources} caption={`Resources in ${g.title}`} /></div>
      </section>
    )}

    <section class="mt-12" aria-labelledby="sources">
      <h2 id="sources" class="text-xl font-bold text-slate-900">Primary sources</h2>
      <ul class="mt-3 space-y-1.5 text-sm">
        {g.sources.map((s) => <li class="flex gap-2"><span aria-hidden="true" class="text-slate-400">→</span><a class="inline-block break-words py-0.5 text-brand-700 underline-offset-2 hover:underline" href={s.url} rel="noopener">{s.label}</a></li>)}
      </ul>
    </section>

    <a href={`/guides/${next.id}/`} class="group mt-12 flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-panel p-4 transition-colors hover:border-brand-400">
      <span><span class="block text-xs text-slate-500">Next guide</span><span class="mt-0.5 block font-semibold text-slate-900 group-hover:text-brand-700">{next.data.h1}</span></span>
      <ArrowRight size={16} aria-hidden="true" class="shrink-0 text-brand-700" />
    </a>
  </article>
</Layout>

<script>
  // Wide Markdown tables scroll sideways on phones; wrap each in a labelled region keyboard users can focus.
  for (const table of document.querySelectorAll<HTMLTableElement>('.guide-prose table')) {
    const wrap = document.createElement('div');
    wrap.className = 'table-scroll';
    wrap.tabIndex = 0;
    wrap.setAttribute('role', 'region');
    wrap.setAttribute('aria-label', 'Table (scrolls sideways)');
    table.replaceWith(wrap);
    wrap.append(table);
  }
</script>
