---
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/Badge.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import EntryCard from '../../components/EntryCard.astro';
import ExternalLink from 'lucide-astro/ExternalLink';
import { LAST_CHECKED, entries, type Entry } from '../../data/directoryData';
import { SITE_NAME, SITE_URL } from '../../config/site';
import { accessLabel, badgeList, categoryById, entryPath, formatSize, related } from '../../utils/format';

export function getStaticPaths() {
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
interface Props { entry: Entry }
const { entry } = Astro.props;
const cat = categoryById(entry.category);
const kindWord = entry.kind === 'api' ? 'API' : 'dataset';
const pageUrl = new URL(entryPath(entry), SITE_URL).href;

const facts: [string, string][] = [
  ['Type', entry.kind === 'api' ? 'API' : 'Dataset'],
  ['Provider', entry.provider],
  ['License', entry.license],
  ['Access', accessLabel[entry.access]],
  ['Format', entry.format],
];
if (entry.sizeMB !== undefined) facts.push(['Download size', `${formatSize(entry.sizeMB)} (approx.)`]);
if (entry.rateLimit) facts.push(['Free limits', entry.rateLimit]);
facts.push(['Last checked', LAST_CHECKED]);

const jsonLd = [
  entry.kind === 'dataset'
    ? { '@type': 'Dataset', name: entry.name, description: entry.description, url: pageUrl, sameAs: entry.url, license: entry.license, keywords: entry.tags, creator: { '@type': 'Organization', name: entry.provider }, isAccessibleForFree: true }
    : { '@type': 'WebAPI', name: entry.name, description: entry.description, url: pageUrl, documentation: entry.docsUrl, provider: { '@type': 'Organization', name: entry.provider } },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE_NAME, item: SITE_URL + '/' },
      { '@type': 'ListItem', position: 2, name: cat.name, item: new URL(`/categories/${cat.id}/`, SITE_URL).href },
      { '@type': 'ListItem', position: 3, name: entry.name, item: pageUrl },
    ],
  },
];
---
<Layout title={`${entry.name}: free ${kindWord} for AI/ML projects`} description={`${entry.summary} License: ${entry.license}. Includes starter code and gotchas.`} jsonLd={jsonLd}>
  <div class="mx-auto max-w-4xl px-4 py-10">
    <nav aria-label="Breadcrumb" class="text-sm text-slate-500">
      <a class="hover:text-brand-700" href="/">Directory</a> / <a class="hover:text-brand-700" href={`/categories/${cat.id}/`}>{cat.name}</a>
    </nav>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{entry.name}</h1>
    <p class="mt-3 text-lg text-slate-600">{entry.summary}</p>
    <div class="mt-4 flex flex-wrap gap-1.5">{badgeList(entry).map((b) => <Badge badge={b} />)}</div>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={entry.url} rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-700">Open {kindWord} <ExternalLink size={14} aria-hidden="true" /></a>
      <a href={entry.docsUrl} rel="noopener" class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Docs <ExternalLink size={14} aria-hidden="true" /></a>
    </div>

    <section class="mt-10" aria-labelledby="about"><h2 id="about" class="text-xl font-bold text-slate-900">About</h2><p class="mt-2 leading-relaxed text-slate-700">{entry.description}</p></section>

    <section class="mt-10" aria-labelledby="facts">
      <h2 id="facts" class="text-xl font-bold text-slate-900">Quick facts</h2>
      <dl class="mt-3 divide-y divide-slate-100 rounded-xl border border-slate-200 bg-white text-sm">
        {facts.map(([k, v]) => <div class="grid gap-1 px-4 py-3 sm:grid-cols-3"><dt class="font-medium text-slate-900">{k}</dt><dd class="text-slate-700 sm:col-span-2">{v}</dd></div>)}
      </dl>
    </section>

    <section class="mt-10" aria-labelledby="start"><h2 id="start" class="mb-3 text-xl font-bold text-slate-900">Starter code</h2><CodeBlock snippet={entry.snippet} /></section>

    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      <section aria-labelledby="ideas"><h2 id="ideas" class="text-xl font-bold text-slate-900">Project ideas</h2><ul class="mt-2 list-disc space-y-1 pl-5 text-slate-700">{entry.useCases.map((u) => <li>{u}</li>)}</ul></section>
      <section aria-labelledby="gotchas"><h2 id="gotchas" class="text-xl font-bold text-slate-900">Watch out for</h2><ul class="mt-2 list-disc space-y-1 pl-5 text-slate-700">{entry.gotchas.map((u) => <li>{u}</li>)}</ul></section>
    </div>

    {(entry.quotas || entry.sizeMB !== undefined) && (
      <p class="mt-8 rounded-lg bg-brand-50 p-4 text-sm text-brand-700">Will this fit your project? <a class="font-semibold underline" href={`/estimator/?entry=${entry.slug}`}>Check it in the estimator</a>.</p>
    )}

    <section class="mt-12" aria-labelledby="rel">
      <h2 id="rel" class="text-xl font-bold text-slate-900">More in {cat.name}</h2>
      <div class="mt-3 grid gap-4 sm:grid-cols-3">{related(entry).map((e) => <EntryCard entry={e} />)}</div>
    </section>
  </div>
</Layout>
