---
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/Badge.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import EntryCard from '../../components/EntryCard.astro';
import VerifiedBadge from '../../components/VerifiedBadge.astro';
import ExternalLink from 'lucide-astro/ExternalLink';
import ShieldCheck from 'lucide-astro/ShieldCheck';
import Gauge from 'lucide-astro/Gauge';
import Check from 'lucide-astro/Check';
import { HARDWARE_TIERS, LAST_CHECKED, entries, type Entry } from '../../data/directoryData';
import { ACCESS_HUBS, hardwareHub } from '../../data/hubs';
import { REPO_URL, SITE_NAME } from '../../config/site';
import { authLabel, badgeList, categoryById, entryPath, formatSize, longDate, lowerFirst, related, richText } from '../../utils/format';
import { breadcrumbs, entryFactSentence, entryFaq, entrySchema, faqPage } from '../../utils/seo';

export function getStaticPaths() {
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
interface Props { entry: Entry }
const { entry } = Astro.props;
const cat = categoryById(entry.category);
const kindWord = entry.kind === 'api' ? 'API' : 'dataset';
const hwHub = hardwareHub(entry.hardware);
const accessHubs = ACCESS_HUBS.filter((h) => h.filter(entry));
const faq = entryFaq(entry);
const snippetHeading =
  entry.snippet.lang === 'python' ? 'Python Quickstart Snippet' : `Quickstart Snippet (${entry.snippet.lang === 'bash' ? 'Shell' : 'JavaScript'})`;

const langName = { python: 'Python', bash: 'Shell', javascript: 'JavaScript' }[entry.snippet.lang];
const bareUrl = (u: string) => u.replace(/^https?:\/\//, '').replace(/\/$/, '');
const size =
  entry.sizeMB !== undefined
    ? `${formatSize(entry.sizeMB)} download (approx.)`
    : entry.access === 'local'
      ? 'No dataset; model weights download separately'
      : 'Nothing to download (hosted API)';

// Labelled one per row so an answer engine can lift any single attribute and cite it.
const facts: [label: string, value: string, href?: string][] = [
  ['Task', entry.task],
  ['Domain', cat.name, `/categories/${cat.id}/`],
  ['Type', entry.kind === 'api' ? 'API' : 'Dataset'],
  ['Provider', entry.provider],
  ['Size', size],
  ['Samples', entry.samples],
  ['Auth / sign-up', authLabel(entry)],
  ['License', entry.license, entry.licenseUrl],
  ['Hardware fit', HARDWARE_TIERS[entry.hardware].label, `/hardware/${hwHub.slug}/`],
  ['Baseline benchmark', entry.baselineBenchmark],
  ['Time to baseline', entry.timeToBaseline],
  ['Starter snippet', `${entry.snippet.title} (${langName}, below)`, '#start'],
  ['Format', entry.format],
];
if (entry.rateLimit) facts.push(['Free limits', entry.rateLimit]);
facts.push(['Source', bareUrl(entry.url), entry.url]);
if (entry.docsUrl !== entry.url) facts.push(['Documentation', bareUrl(entry.docsUrl), entry.docsUrl]);
facts.push(['Last verified', longDate(LAST_CHECKED)]);
const reportUrl = `${REPO_URL}/issues/new?title=${encodeURIComponent(`Correction: ${entry.name}`)}`;

const jsonLd = [
  entrySchema(entry),
  breadcrumbs([[SITE_NAME, '/'], [cat.name, `/categories/${cat.id}/`], [entry.name, entryPath(entry)]]),
  faqPage(faq),
];
---
<Layout title={`${entry.name}: free ${kindWord} for AI/ML projects`} description={`${entry.summary} License: ${entry.license}. Baseline, leakage checklist and starter code.`} jsonLd={jsonLd} ogType="article">
  <article class="mx-auto max-w-4xl px-4 py-10">
    <nav aria-label="Breadcrumb" class="text-sm text-slate-500">
      <ol class="flex flex-wrap gap-1">
        <li><a class="hover:text-brand-700" href="/">Directory</a> /</li>
        <li><a class="hover:text-brand-700" href={`/categories/${cat.id}/`}>{cat.name}</a> /</li>
        <li aria-current="page" class="text-slate-700">{entry.name}</li>
      </ol>
    </nav>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{entry.name}</h1>
    <p class="mt-3 text-lg text-slate-600">{entry.summary}</p>
    <div class="mt-4 flex flex-wrap items-center gap-1.5">
      <VerifiedBadge />
      {badgeList(entry).map((b) => <Badge badge={b} />)}
    </div>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={entry.url} rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-700">Open {kindWord} <ExternalLink size={14} aria-hidden="true" /></a>
      <a href={entry.docsUrl} rel="noopener" class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Docs <ExternalLink size={14} aria-hidden="true" /></a>
    </div>

    <section class="mt-10" aria-labelledby="about"><h2 id="about" class="text-xl font-bold text-slate-900">About</h2><p class="mt-2 leading-relaxed text-slate-700">{entry.description}</p></section>

    <section class="mt-10" aria-labelledby="facts">
      <h2 id="facts" class="text-xl font-bold text-slate-900">Key facts</h2>
      <p class="mt-2 leading-relaxed text-slate-700">{entryFactSentence(entry)}</p>
      <dl class="mt-4 divide-y divide-slate-100 rounded-xl border border-slate-200 bg-white text-sm">
        {facts.map(([k, v, href]) => (
          <div class="grid gap-1 px-4 py-3 sm:grid-cols-3">
            <dt class="font-medium text-slate-900">{k}</dt>
            <dd class="break-words text-slate-700 sm:col-span-2">
              {href ? <a class="text-brand-700 underline-offset-2 hover:underline" href={href} rel={href.startsWith('http') ? (k === 'License' ? 'noopener license' : 'noopener') : undefined}>{v}</a> : <span set:html={richText(v)} />}
            </dd>
          </div>
        ))}
      </dl>
      <p class="mt-3 text-xs leading-relaxed text-slate-500">
        Checked against the source, documentation and license links above on <time datetime={LAST_CHECKED}>{longDate(LAST_CHECKED)}</time>. Sizes, timings and baseline scores are typical approximations; the provider's page is the source of truth for license and limits. Spotted something out of date? <a class="font-medium text-brand-700 hover:underline" href={reportUrl} rel="noopener">Report a correction on GitHub</a>.
      </p>
    </section>

    <section class="mt-10" aria-labelledby="start"><h2 id="start" class="mb-3 text-xl font-bold text-slate-900">{snippetHeading}</h2><CodeBlock snippet={entry.snippet} /></section>

    <section class="mt-10" aria-labelledby="prep">
      <h2 id="prep" class="flex items-center gap-2 text-xl font-bold text-slate-900"><ShieldCheck size={20} aria-hidden="true" class="text-brand-600" /> Data Leakage &amp; Preprocessing Checklist</h2>
      <ul class="mt-3 space-y-2">
        {entry.preprocessingTips.map((t) => (
          <li class="flex gap-3 rounded-lg border border-slate-200 bg-white p-3 text-slate-700">
            <Check size={18} aria-hidden="true" class="mt-0.5 shrink-0 text-emerald-600" />
            <span set:html={richText(t)} />
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-10" aria-labelledby="baseline">
      <h2 id="baseline" class="flex items-center gap-2 text-xl font-bold text-slate-900"><Gauge size={20} aria-hidden="true" class="text-brand-600" /> Expected Baseline Benchmark</h2>
      <p class="mt-3 rounded-xl border border-brand-100 bg-brand-50 p-4 leading-relaxed text-slate-800" set:html={richText(entry.baselineBenchmark)} />
      <p class="mt-2 text-xs text-slate-500">Typical ranges for a first attempt; your numbers depend on preprocessing, seed and hardware. Time to baseline: {entry.timeToBaseline}.</p>
    </section>

    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      <section aria-labelledby="ideas"><h2 id="ideas" class="text-xl font-bold text-slate-900">{entry.useCases.length} Starter Project Ideas</h2><ol class="mt-2 list-decimal space-y-1 pl-5 text-slate-700">{entry.useCases.map((u) => <li>{u}</li>)}</ol></section>
      <section aria-labelledby="gotchas"><h2 id="gotchas" class="text-xl font-bold text-slate-900">Watch out for</h2><ul class="mt-2 list-disc space-y-1 pl-5 text-slate-700">{entry.gotchas.map((u) => <li>{u}</li>)}</ul></section>
    </div>

    {(entry.quotas || entry.sizeMB !== undefined) && (
      <p class="mt-8 rounded-lg bg-brand-50 p-4 text-sm text-brand-700">Will this fit your project? <a class="font-semibold underline" href={`/estimator/?entry=${entry.slug}`}>Check it in the estimator</a>.</p>
    )}

    <section class="mt-12" aria-labelledby="faq">
      <h2 id="faq" class="text-xl font-bold text-slate-900">FAQ</h2>
      <div class="mt-3 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
        {faq.map((f) => (
          <div class="p-4">
            <h3 class="font-semibold text-slate-900">{f.q}</h3>
            <p class="mt-1 leading-relaxed text-slate-700">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <nav class="mt-10 rounded-xl border border-slate-200 bg-white p-4 text-sm" aria-label="Related collections">
      <p class="font-semibold text-slate-900">Find similar resources</p>
      <ul class="mt-2 flex flex-wrap gap-2">
        <li><a class="inline-block rounded-full border border-slate-300 px-3 py-1 text-slate-700 hover:border-brand-400 hover:text-brand-700" href={`/categories/${cat.id}/`}>All {lowerFirst(cat.name)}</a></li>
        <li><a class="inline-block rounded-full border border-slate-300 px-3 py-1 text-slate-700 hover:border-brand-400 hover:text-brand-700" href={`/hardware/${hwHub.slug}/`}>Runs on: {hwHub.label}</a></li>
        {accessHubs.map((h) => <li><a class="inline-block rounded-full border border-slate-300 px-3 py-1 text-slate-700 hover:border-brand-400 hover:text-brand-700" href={`/access/${h.slug}/`}>{h.label}</a></li>)}
        <li><a class="inline-block rounded-full border border-slate-300 px-3 py-1 text-slate-700 hover:border-brand-400 hover:text-brand-700" href="/compare/">Compare all {entries.length}</a></li>
      </ul>
    </nav>

    <section class="mt-12" aria-labelledby="rel">
      <h2 id="rel" class="text-xl font-bold text-slate-900">More in {cat.name}</h2>
      <div class="mt-3 grid gap-4 sm:grid-cols-3">{related(entry).map((e) => <EntryCard entry={e} />)}</div>
    </section>
  </article>
</Layout>
