---
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/Badge.astro';
import PageHeader from '../../components/PageHeader.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import EntryCard from '../../components/EntryCard.astro';
import ComboCard from '../../components/ComboCard.astro';
import VerifiedBadge from '../../components/VerifiedBadge.astro';
import ExternalLink from 'lucide-astro/ExternalLink';
import Check from 'lucide-astro/Check';
import CircleAlert from 'lucide-astro/CircleAlert';
import { HARDWARE_TIERS, PRICING, entries, type Entry } from '../../data/directoryData';
import { ACCESS_HUBS, hardwareHub } from '../../data/hubs';
import { combosFor } from '../../data/guides';
import { REPO_URL, SITE_NAME } from '../../config/site';
import { authLabel, badgeList, categoryById, entryPath, longDate, lowerFirst, related, richText, sizeLabel } from '../../utils/format';
import { breadcrumbs, entryFaq, entryPage, entrySchema, faqPage } from '../../utils/seo';

export function getStaticPaths() {
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
interface Props { entry: Entry }
const { entry } = Astro.props;
const cat = categoryById(entry.category);
const kindWord = entry.kind === 'api' ? 'API' : 'dataset';
const hwHub = hardwareHub(entry.hardware);
const accessHubs = ACCESS_HUBS.filter((h) => h.filter(entry));
const faq = entryFaq(entry);

const langName = { python: 'Python', bash: 'Shell', javascript: 'JavaScript' }[entry.snippet.lang];
const paid = entry.pricing === 'pay-as-you-go';
const size =
  entry.sizeMB !== undefined
    ? `${sizeLabel(entry)} to download`
    : entry.access === 'local'
      ? 'No dataset; model weights download separately'
      : 'Nothing to download (hosted API)';

// One labelled fact per row, so an answer engine can lift any single attribute. Baseline, starter
// code, sources and verification each have their own section below, so they are not repeated here.
const facts: [label: string, value: string, href?: string][] = [
  ['Task', entry.task],
  ['Type', entry.kind === 'api' ? 'API' : 'Dataset'],
  ['Category', cat.name, `/categories/${cat.id}/`],
  ['Provider', entry.provider],
  ['Format', entry.format],
  ['Size', size],
  ['Samples', entry.samples],
  ['Access', authLabel(entry)],
  ['Cost', PRICING[entry.pricing].label],
];
if (entry.rateLimit) facts.push(['Limits', entry.rateLimit]);
facts.push(['License', entry.license, entry.licenseUrl]);
facts.push(['Hardware fit', HARDWARE_TIERS[entry.hardware].label, `/hardware/${hwHub.slug}/`]);
const v = entry.verification;
const reportUrl = `${REPO_URL}/issues/new?title=${encodeURIComponent(`Correction: ${entry.name}`)}`;

const combos = combosFor(entry);
const title = entry.seoTitle;
const longDescription = `${entry.summary} License: ${entry.license}. Baseline, leakage checklist and starter code.`;
// Long license wording would push the snippet past what search results show; keep the summary instead.
const description = longDescription.length <= 160 ? longDescription : `${entry.summary} License, limits, leakage checklist and starter code.`;

const trail: [string, string][] = [[SITE_NAME, '/'], [cat.name, `/categories/${cat.id}/`], [entry.name, entryPath(entry)]];
const jsonLd = [entryPage(entry, title, description), entrySchema(entry), breadcrumbs(trail), faqPage(faq)];
---
<Layout title={title} description={description} jsonLd={jsonLd} ogType="article">
  <article class="mx-auto max-w-4xl px-4 py-10">
    <PageHeader trail={trail} title={entry.name} lead={entry.summary}>
      <div class="mt-4 flex flex-wrap items-center gap-1.5">
        <a href="#verification" class="rounded-md"><VerifiedBadge verification={v} /></a>
        {badgeList(entry).map((b) => <Badge badge={b} />)}
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={entry.url} rel="noopener" class="btn-primary">Open {kindWord} <ExternalLink size={14} aria-hidden="true" /></a>
        {entry.docsUrl !== entry.url && <a href={entry.docsUrl} rel="noopener" class="btn-secondary">Documentation <ExternalLink size={14} aria-hidden="true" /></a>}
      </div>
    </PageHeader>

    {paid && (
      <p class="callout-warn mt-6">
        <CircleAlert size={18} aria-hidden="true" class="mt-0.5 shrink-0" />
        <span><strong>Not free on a free account.</strong> {PRICING[entry.pricing].hint}</span>
      </p>
    )}

    <section class="mt-10" aria-labelledby="about"><h2 id="about" class="section-title">About</h2><p class="mt-2 leading-relaxed text-slate-700">{entry.description}</p></section>

    <section class="mt-10" aria-labelledby="facts">
      <h2 id="facts" class="section-title">Key facts</h2>
      <dl class="mt-3 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-panel text-sm">
        {facts.map(([k, val, href]) => (
          <div class="grid gap-1 px-4 py-2.5 sm:grid-cols-[11rem_1fr]">
            <dt class="text-slate-500">{k}</dt>
            <dd class:list={['break-words', paid && (k === 'Access' || k === 'Cost') ? 'text-amber-800' : 'text-slate-800']}>
              {href ? <a class="link" href={href} rel={href.startsWith('http') ? (k === 'License' ? 'noopener license' : 'noopener') : undefined}>{val}</a> : <span set:html={richText(val)} />}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mt-10" aria-labelledby="verification">
      <h2 id="verification" class="section-title">Verification</h2>
      <p class="mt-2 leading-relaxed text-slate-700">
        {v.status === 'verified'
          ? <>License, access, size and sample count were checked against these primary sources on <time datetime={v.checked}>{longDate(v.checked)}</time>.</>
          : <>Checked against these primary sources on <time datetime={v.checked}>{longDate(v.checked)}</time>, but some details could not be confirmed.</>}
      </p>
      <ul class="mt-3 space-y-1.5 text-sm">
        {v.sources.map((src) => (
          <li class="flex gap-2"><span aria-hidden="true" class="text-slate-400">→</span><a class="link inline-block break-words py-0.5 font-normal" href={src.url} rel="noopener">{src.label}</a></li>
        ))}
      </ul>
      {v.open?.length ? (
        <div class="callout-warn mt-4 flex-col gap-2">
          <p class="flex items-center gap-2 font-semibold"><CircleAlert size={16} aria-hidden="true" /> Not yet confirmed</p>
          <ul class="list-disc space-y-1 pl-5">{v.open.map((o) => <li>{o}</li>)}</ul>
        </div>
      ) : null}
      {v.notes?.length ? <ul class="mt-4 list-disc space-y-1 pl-5 text-sm leading-relaxed text-slate-600">{v.notes.map((n) => <li>{n}</li>)}</ul> : null}
      <p class="meta-note mt-4">The provider's page is the source of truth for licenses and limits. Spotted something out of date? <a class="link" href={reportUrl} rel="noopener">Report a correction on GitHub</a> or read <a class="link" href="/about/#verified">how entries are verified</a>.</p>
    </section>

    <section class="mt-10" aria-labelledby="start"><h2 id="start" class="section-title mb-3">{langName} quickstart</h2><CodeBlock snippet={entry.snippet} /></section>

    <section class="mt-10" aria-labelledby="prep">
      <h2 id="prep" class="section-title">Data leakage and preprocessing checklist</h2>
      <ul class="mt-3 space-y-2">
        {entry.preprocessingTips.map((t) => (
          <li class="flex gap-3 text-slate-700">
            <Check size={18} aria-hidden="true" class="mt-0.5 shrink-0 text-emerald-600" />
            <span class="leading-relaxed" set:html={richText(t)} />
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-10" aria-labelledby="baseline">
      <h2 id="baseline" class="section-title">Expected baseline</h2>
      <p class="mt-2 leading-relaxed text-slate-800" set:html={richText(entry.baselineBenchmark)} />
      <p class="meta-note mt-2">
        {entry.baselineSource
          ? <>Source: <a class="link" href={entry.baselineSource.url} rel="noopener">{entry.baselineSource.label}</a>.</>
          : <>A rough guide from common practice, not a figure from a primary source.</>}
        {' '}Estimated time to baseline: {entry.timeToBaseline}. Your numbers will depend on preprocessing, seed and hardware.
      </p>
    </section>

    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      <section aria-labelledby="ideas"><h2 id="ideas" class="section-title">Starter project ideas</h2><ol class="mt-2 list-decimal space-y-1 pl-5 text-slate-700">{entry.useCases.map((u) => <li>{u}</li>)}</ol></section>
      <section aria-labelledby="gotchas"><h2 id="gotchas" class="section-title">Watch out for</h2><ul class="mt-2 list-disc space-y-1 pl-5 text-slate-700">{entry.gotchas.map((u) => <li>{u}</li>)}</ul></section>
    </div>

    {combos.length > 0 && (
      <section class="mt-10" aria-labelledby="combos">
        <h2 id="combos" class="section-title">Dataset + live API combo {combos.length === 1 ? 'idea' : 'ideas'}</h2>
        <p class="section-lead">{entry.kind === 'api' ? `Feed a trained model live inputs from ${entry.name}.` : `Train on ${entry.name}, then run the model on live data from a free API.`}</p>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">{combos.map((c) => <ComboCard combo={c} />)}</div>
      </section>
    )}

    {(entry.quotas || entry.sizeMB !== undefined) && (
      <p class="mt-8 text-sm text-slate-600">Will it fit your project? <a class="link" href={`/estimator/#entry=${entry.slug}`}>Check {entry.quotas ? 'the free quota' : 'disk and memory'} in the estimator</a>.</p>
    )}

    <section class="mt-12" aria-labelledby="faq">
      <h2 id="faq" class="section-title">FAQ</h2>
      <div class="mt-3 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-panel">
        {faq.map((f) => (
          <div class="p-4">
            <h3 class="font-semibold text-slate-900">{f.q}</h3>
            <p class="mt-1 leading-relaxed text-slate-700">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-12" aria-labelledby="rel">
      <h2 id="rel" class="section-title">More in {cat.name}</h2>
      <div class="mt-3 grid gap-4 sm:grid-cols-3">{related(entry).map((e) => <EntryCard entry={e} />)}</div>
      <nav class="mt-5" aria-label="Related collections">
        <ul class="flex flex-wrap gap-2">
          <li><a class="chip-link" href={`/categories/${cat.id}/`}>All {lowerFirst(cat.name)}</a></li>
          <li><a class="chip-link" href={`/hardware/${hwHub.slug}/`}>Runs on: {hwHub.label}</a></li>
          {accessHubs.map((h) => <li><a class="chip-link" href={`/access/${h.slug}/`}>{h.label}</a></li>)}
          <li><a class="chip-link" href="/compare/">Compare all {entries.length}</a></li>
        </ul>
      </nav>
    </section>
  </article>
</Layout>
