---
import HubPage from '../../components/HubPage.astro';
import { ACCESS_HUBS, type Hub } from '../../data/hubs';

export function getStaticPaths() {
  return ACCESS_HUBS.map((hub) => ({ params: { slug: hub.slug }, props: { hub } }));
}
interface Props { hub: Hub }
---
<HubPage hub={Astro.props.hub} section={{ base: '/access/', name: 'Access' }} siblings={ACCESS_HUBS} />
