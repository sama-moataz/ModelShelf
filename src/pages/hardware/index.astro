---
import HubIndex from '../../components/HubIndex.astro';
import { HARDWARE_HUBS } from '../../data/hubs';
import { directoryAtAGlance } from '../../data/guides';

const glance = directoryAtAGlance();
---
<HubIndex
  section={{ base: '/hardware/', name: 'Hardware' }}
  title="ML datasets and APIs by hardware tier"
  description="Which open datasets and APIs run on a laptop CPU, which need a free Google Colab T4 GPU, and which need a bigger GPU or a subset."
  answer={`${glance.hardware} ${glance.hostedNote}`}
  hubs={HARDWARE_HUBS}
/>
