---
import Layout from '../layouts/Layout.astro';
import EntryCard from '../components/EntryCard.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import Search from 'lucide-astro/Search';
import GraduationCap from 'lucide-astro/GraduationCap';
import { BADGES, CATEGORIES, LAST_CHECKED, entries } from '../data/directoryData';
import { SITE_NAME } from '../config/site';
import { entryPath, longDate, plainText } from '../utils/format';
import { ACCESS_HUBS, HARDWARE_HUBS, hubEntries } from '../data/hubs';
import { homeQuickAnswers } from '../data/guides';
import { abs, faqPage, siteGraph } from '../utils/seo';

const datasetCount = entries.filter((e) => e.kind === 'dataset').length;
const apiCount = entries.length - datasetCount;
const sorted = [...entries].sort((a, b) => a.name.localeCompare(b.name));

const faqs = [
  { q: 'Is everything on ModelShelf really free?', a: 'Every dataset can be downloaded at no cost, and every API has a free tier or runs locally. Free tiers have limits, which are listed on each page, and some datasets restrict commercial use.' },
  { q: 'What do the student-first badges mean?', a: 'Badges flag the things students trip over: whether you need a signup or credit card, whether commercial use is allowed, and whether the resource is small enough for a laptop.' },
  { q: 'Can I use these datasets in a commercial product?', a: 'Only if the license allows it. Look for the "Commercial OK" badge, and read the license text on the provider\'s page, because terms can change.' },
  { q: 'How current are the links and limits?', a: `Every source, documentation and license link was last checked on ${longDate(LAST_CHECKED)}. API free tiers change often, so each page links to the provider's docs as the source of truth.` },
  { q: 'How do I suggest a resource?', a: 'Use the submit page. It prepares a GitHub issue with the details we need, so a maintainer can verify it.' },
];

const quickAnswers = homeQuickAnswers();

const jsonLd = [
  ...siteGraph(),
  {
    '@type': 'ItemList',
    name: 'Open datasets and free APIs for AI/ML projects',
    itemListElement: sorted.map((e, i) => ({ '@type': 'ListItem', position: i + 1, name: e.name, url: abs(entryPath(e)) })),
  },
  // Quick answers first, in the same words as the visible blocks.
  faqPage([...quickAnswers.map((a) => ({ q: a.q, a: plainText([a.answer, ...a.points].join(' ')) })), ...faqs]),
];
const filterBadges = ['no-signup', 'no-card', 'commercial-ok', 'laptop-friendly'] as const;
---
<Layout jsonLd={jsonLd}>
  <section class="border-b border-slate-200 bg-gradient-to-b from-brand-50 to-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
      <p class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-xs font-semibold text-brand-700 shadow-sm ring-1 ring-brand-100">
        <GraduationCap size={14} aria-hidden="true" /> Built for students and indie builders
      </p>
      <h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        Open datasets and free APIs for your next AI/ML project
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-slate-600">
        {SITE_NAME} is a free, curated directory of {datasetCount} open datasets and {apiCount} free APIs for students, hackathon teams and indie AI builders. Each one lists its license, limits, hardware fit and a copy-paste starter. No paywalls, no trial traps.
      </p>
      <a href="#directory" class="mt-6 inline-block rounded-lg bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow hover:bg-brand-700">Browse the directory</a>
      <ul class="mt-8 flex flex-wrap gap-2" aria-label="Browse by category">
        {CATEGORIES.map((c) => <li><a href={`/categories/${c.id}/`} class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm text-slate-700 hover:border-brand-500 hover:text-brand-700">{c.name}</a></li>)}
      </ul>
    </div>
  </section>

  <section id="directory" class="mx-auto max-w-6xl scroll-mt-16 px-4 pt-10">
    <h2 class="text-2xl font-bold text-slate-900">The directory</h2>
    <form id="filters" class="mt-4 grid gap-4 rounded-xl border border-slate-200 bg-white p-4 shadow-sm md:grid-cols-4" role="search" onsubmit="return false">
      <div class="md:col-span-2">
        <label for="q" class="text-xs font-semibold uppercase tracking-wide text-slate-500">Search</label>
        <div class="relative mt-1">
          <Search size={16} class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" aria-hidden="true" />
          <input id="q" type="search" placeholder="Try “sentiment”, “weather”, “CC0”…" class="w-full rounded-lg border border-slate-300 py-2 pl-9 pr-3 text-sm focus:border-brand-500" autocomplete="off" />
        </div>
      </div>
      <div>
        <label for="category" class="text-xs font-semibold uppercase tracking-wide text-slate-500">Category</label>
        <select id="category" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm">
          <option value="">All categories</option>
          {CATEGORIES.map((c) => <option value={c.id}>{c.name}</option>)}
        </select>
      </div>
      <div>
        <label for="sort" class="text-xs font-semibold uppercase tracking-wide text-slate-500">Sort by</label>
        <select id="sort" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm">
          <option value="name">Name (A to Z)</option>
          <option value="badges">Most student-friendly</option>
          <option value="size">Smallest download</option>
        </select>
      </div>
      <fieldset class="md:col-span-4">
        <legend class="text-xs font-semibold uppercase tracking-wide text-slate-500">Type and badges</legend>
        <div class="mt-2 flex flex-wrap gap-2">
          <label class="chip"><input type="radio" name="kind" value="" checked /> All</label>
          <label class="chip"><input type="radio" name="kind" value="dataset" /> Datasets</label>
          <label class="chip"><input type="radio" name="kind" value="api" /> APIs</label>
          <span class="mx-1 hidden h-6 w-px bg-slate-200 sm:block" aria-hidden="true"></span>
          {filterBadges.map((b) => <label class="chip"><input type="checkbox" name="badge" value={b} /> {BADGES[b].label}</label>)}
        </div>
      </fieldset>
    </form>

    <p id="count" class="mt-5 text-sm text-slate-600" aria-live="polite">Showing {entries.length} of {entries.length} resources</p>
    <div id="grid" class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {sorted.map((e) => <EntryCard entry={e} />)}
    </div>
    <div id="empty" hidden class="mt-6 rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center">
      <p class="font-semibold text-slate-900">Nothing matches those filters</p>
      <p class="mt-1 text-sm text-slate-600">Clear a filter, or <a class="text-brand-700 underline" href="/submit/">suggest a resource</a>.</p>
      <button id="reset" type="button" class="mt-4 rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium hover:bg-slate-50">Reset filters</button>
    </div>
  </section>

  <section class="mx-auto mt-16 max-w-6xl px-4" aria-labelledby="answers-h">
    <h2 id="answers-h" class="text-2xl font-bold text-slate-900">Quick answers</h2>
    <p class="mt-1 text-slate-600">The two questions students ask most before picking a dataset or API.</p>
    <div class="mt-5 grid gap-6 lg:grid-cols-2">
      {quickAnswers.map((a) => <QuickAnswer id={a.id} heading={a.q} answer={a.answer} points={a.points} level={3} />)}
    </div>
  </section>

  <section class="mx-auto mt-16 max-w-6xl px-4" aria-labelledby="collections-h">
    <h2 id="collections-h" class="text-2xl font-bold text-slate-900">Browse by what you have</h2>
    <p class="mt-1 text-slate-600">Start from your hardware or your license needs, or <a class="font-medium text-brand-700 hover:underline" href="/compare/">compare everything in one table</a>.</p>
    <div class="mt-5 grid gap-6 md:grid-cols-2">
      {[{ title: 'By hardware', base: '/hardware/', hubs: HARDWARE_HUBS }, { title: 'By access & license', base: '/access/', hubs: ACCESS_HUBS }].map((g) => (
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500">{g.title}</h3>
          <ul class="mt-2 space-y-2">
            {g.hubs.map((h) => (
              <li>
                <a href={`${g.base}${h.slug}/`} class="flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm transition hover:border-brand-300 hover:shadow-md">
                  <span class="font-medium text-slate-900">{h.title}</span>
                  <span class="shrink-0 rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">{hubEntries(h).length}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto mt-16 max-w-3xl px-4" aria-labelledby="faq-h">
    <h2 id="faq-h" class="text-2xl font-bold text-slate-900">Frequently asked questions</h2>
    <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
      {faqs.map((f) => (
        <details class="group p-4">
          <summary class="cursor-pointer list-none font-medium text-slate-900 marker:hidden">{f.q}</summary>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>

<style is:global>
  .chip { display: inline-flex; align-items: center; gap: 0.4rem; border: 1px solid #cbd5e1; border-radius: 9999px; padding: 0.3rem 0.8rem; font-size: 0.8rem; cursor: pointer; background: #fff; }
  .chip:has(input:checked) { background: var(--color-brand-50); border-color: var(--color-brand-500); color: var(--color-brand-700); font-weight: 600; }
  .chip input { accent-color: var(--color-brand-600); }
</style>

<script>
  // Cards are server-rendered, so the page is fully crawlable without JS; this only hides/reorders them.
  const form = document.getElementById('filters') as HTMLFormElement;
  const grid = document.getElementById('grid') as HTMLElement;
  const cards = Array.from(grid.querySelectorAll<HTMLElement>('.entry-card'));
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  const q = document.getElementById('q') as HTMLInputElement;
  const category = document.getElementById('category') as HTMLSelectElement;
  const sort = document.getElementById('sort') as HTMLSelectElement;

  function apply() {
    const term = q.value.trim().toLowerCase();
    const kind = (form.querySelector('input[name=kind]:checked') as HTMLInputElement).value;
    const badges = Array.from(form.querySelectorAll<HTMLInputElement>('input[name=badge]:checked')).map((i) => i.value);
    let shown = 0;
    for (const c of cards) {
      const have = (c.dataset.badges ?? '').split(' ');
      const ok =
        (!term || term.split(/\s+/).every((t) => c.dataset.search!.includes(t))) &&
        (!kind || c.dataset.kind === kind) &&
        (!category.value || c.dataset.category === category.value) &&
        badges.every((b) => have.includes(b));
      c.hidden = !ok;
      if (ok) shown++;
    }
    const by = sort.value;
    const key = (c: HTMLElement) => (by === 'badges' ? -Number(c.dataset.badgeCount) : by === 'size' ? (c.dataset.size === '' ? Infinity : Number(c.dataset.size)) : 0);
    [...cards]
      .sort((a, b) => key(a) - key(b) || a.dataset.name!.localeCompare(b.dataset.name!))
      .forEach((c) => grid.appendChild(c));
    count.textContent = `Showing ${shown} of ${cards.length} resources`;
    empty.hidden = shown > 0;
  }

  form.addEventListener('input', apply);
  document.getElementById('reset')!.addEventListener('click', () => { form.reset(); apply(); });
  // Allow /?q=weather&category=audio deep links.
  const params = new URLSearchParams(location.search);
  if (params.get('q')) q.value = params.get('q')!;
  if (params.get('category')) category.value = params.get('category')!;
  apply();
</script>
