---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found" noindex>
  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="text-sm font-semibold text-brand-700">404</p>
    <h1 class="mt-2 text-3xl font-extrabold text-slate-900">That shelf is empty</h1>
    <p class="mt-3 text-slate-600">The page you were looking for does not exist.</p>
    <a href="/" class="mt-6 inline-block rounded-lg bg-brand-600 px-5 py-3 text-sm font-semibold text-white hover:bg-brand-700">Back to the directory</a>
  </div>
</Layout>
