---
import Library from 'lucide-astro/Library';
import { REPO_URL, SITE_NAME } from '../config/site';
const links = [
  { href: '/', label: 'Directory' },
  { href: '/categories/', label: 'Categories' },
  { href: '/estimator/', label: 'Estimator' },
  { href: '/submit/', label: 'Submit' },
];
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-30 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight text-slate-900">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand-600 text-white"><Library size={18} aria-hidden="true" /></span>
      {SITE_NAME}
    </a>
    <nav aria-label="Main" class="flex items-center gap-1 text-sm font-medium">
      {links.map((l) => {
        const active = l.href === '/' ? path === '/' : path.startsWith(l.href);
        return (
          <a href={l.href} aria-current={active ? 'page' : undefined}
             class:list={['rounded-md px-3 py-2 transition-colors', active ? 'bg-brand-50 text-brand-700' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900']}>
            {l.label}
          </a>
        );
      })}
      <a href={REPO_URL} class="ml-1 hidden rounded-md px-3 py-2 text-slate-600 hover:bg-slate-100 sm:block" rel="noopener">GitHub</a>
    </nav>
  </div>
</header>
