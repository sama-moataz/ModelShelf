---
// Overview of one family of hubs (/hardware/, /access/): a direct answer, then one row per hub.
import Layout from '../layouts/Layout.astro';
import PageHeader from './PageHeader.astro';
import { SITE_NAME } from '../config/site';
import { hubEntries, type Hub } from '../data/hubs';
import { names } from '../data/guides';
import { richText } from '../utils/format';
import { WEBSITE_ID, abs, breadcrumbs } from '../utils/seo';

interface Props {
  section: { base: string; name: string };
  title: string;
  description: string;
  /** Answer-first lead; may use [[slug]] and [label](/path/) copy markup. */
  answer: string;
  hubs: Hub[];
}
const { section, title, description, answer, hubs } = Astro.props;
const rows = hubs.map((h) => {
  const list = hubEntries(h);
  return { hub: h, count: list.length, datasets: list.filter((e) => e.kind === 'dataset').length, examples: list.slice(0, 3) };
});
const trail: [string, string][] = [[SITE_NAME, '/'], [section.name, section.base]];
const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: title,
    description,
    url: abs(section.base),
    isPartOf: { '@type': 'WebSite', '@id': WEBSITE_ID, name: SITE_NAME, url: abs('/') },
    hasPart: hubs.map((h) => ({ '@type': 'CollectionPage', name: h.title, url: abs(`${section.base}${h.slug}/`) })),
  },
  breadcrumbs(trail),
];
---
<Layout title={title} description={description} jsonLd={jsonLd}>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:py-12">
    <PageHeader trail={trail} title={title} lead={answer} />

    <div class="mt-8 overflow-x-auto rounded-xl border border-slate-200 bg-panel" role="region" aria-labelledby="hub-caption" tabindex="0">
      <table class="w-full min-w-[720px] border-collapse text-left text-sm">
        <caption id="hub-caption" class="sr-only">{title}</caption>
        <thead class="bg-slate-50 text-xs text-slate-600">
          <tr>
            <th scope="col" class="px-4 py-3 font-semibold">Collection</th>
            <th scope="col" class="px-4 py-3 font-semibold">What it covers</th>
            <th scope="col" class="px-4 py-3 font-semibold">Resources</th>
            <th scope="col" class="px-4 py-3 font-semibold">Examples</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {rows.map((r) => (
            <tr class="align-top">
              <th scope="row" class="px-4 py-3 font-semibold"><a class="text-brand-700 hover:underline" href={`${section.base}${r.hub.slug}/`}>{r.hub.label}</a></th>
              <td class="px-4 py-3 text-slate-700">{r.hub.metaDescription}</td>
              <td class="whitespace-nowrap px-4 py-3 text-slate-700">{r.count} ({r.datasets} datasets{r.count > r.datasets ? `, ${r.count - r.datasets} APIs` : ''})</td>
              <td class="px-4 py-3 text-slate-700" set:html={richText(names(r.examples))} />
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="mt-4 text-sm text-slate-600">To weigh every resource on size, hardware, access and license at once, use the <a class="link" href="/compare/">comparison table</a>.</p>
  </div>
</Layout>
