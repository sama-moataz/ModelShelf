---
import BadgeCheck from 'lucide-astro/BadgeCheck';
import { LAST_CHECKED } from '../data/directoryData';
import { monthYear } from '../utils/format';

interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<span
  title={`Links, license and limits last checked on ${LAST_CHECKED}`}
  class:list={['inline-flex items-center gap-1 rounded-full bg-sky-50 font-medium text-sky-800 ring-1 ring-inset ring-sky-600/20', compact ? 'px-2 py-0.5 text-[11px]' : 'px-2.5 py-0.5 text-xs']}
>
  <BadgeCheck size={compact ? 12 : 14} aria-hidden="true" />
  Last verified: <time datetime={LAST_CHECKED}>{monthYear(LAST_CHECKED)}</time>
</span>
