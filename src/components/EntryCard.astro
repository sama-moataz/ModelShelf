---
import Badge from './Badge.astro';
import VerifiedBadge from './VerifiedBadge.astro';
import { PRICING, type Entry } from '../data/directoryData';
import { badgeList, entryPath, formatSize, signupShort } from '../utils/format';

interface Props { entry: Entry }
const { entry } = Astro.props;
const search = [entry.name, entry.summary, entry.provider, entry.license, ...entry.tags].join(' ').toLowerCase();
const props: [string, string][] = [
  ['license', entry.license],
  ...(entry.sizeMB !== undefined
    ? [['size', formatSize(entry.sizeMB)] as [string, string]]
    : [['access', signupShort(entry)], ['cost', PRICING[entry.pricing].short]] as [string, string][]),
];
---
<article
  class="entry-card group relative flex min-w-0 flex-col rounded-xl border border-slate-200 bg-panel transition-colors hover:border-brand-400"
  data-name={entry.name.toLowerCase()}
  data-search={search}
  data-kind={entry.kind}
  data-category={entry.category}
  data-badges={entry.badges.join(' ')}
  data-badge-count={entry.badges.length}
  data-size={entry.sizeMB ?? ''}
>
  <div class="flex items-center justify-between gap-2 border-b border-slate-200 px-4 py-2 text-xs">
    <span class:list={['font-semibold', entry.kind === 'api' ? 'text-syn-kw' : 'text-syn-str']}>{entry.kind === 'api' ? 'api' : 'dataset'}</span>
    <span class="truncate text-slate-500">{entry.category}/{entry.slug}</span>
  </div>
  <div class="flex flex-1 flex-col p-4">
    <h3 class="text-base font-bold text-slate-900">
      <a href={entryPath(entry)} class="after:absolute after:inset-0 group-hover:text-brand-700">{entry.name}</a>
    </h3>
    <p class="mt-1.5 text-[13px] leading-relaxed text-slate-600">{entry.summary}</p>
    <div class="mt-3 flex flex-wrap gap-1.5">
      {badgeList(entry).slice(0, 4).map((b) => <Badge badge={b} />)}
    </div>
    <dl class="mt-4 space-y-1 text-xs">
      {props.map(([k, v]) => (
        <div class="flex gap-2">
          <dt class="w-16 shrink-0 text-syn-prop">{k}</dt>
          <dd class="truncate text-slate-700" title={v}>{v}</dd>
        </div>
      ))}
    </dl>
    <div class="mt-auto flex items-center pt-4">
      <VerifiedBadge compact verification={entry.verification} />
    </div>
  </div>
</article>
