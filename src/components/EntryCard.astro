---
import Badge from './Badge.astro';
import { PRICING, type Entry } from '../data/directoryData';
import { badgeList, entryPath, sizeLabel, signupShort } from '../utils/format';

interface Props { entry: Entry }
const { entry } = Astro.props;
const search = [entry.name, entry.summary, entry.provider, entry.license, ...entry.tags].join(' ').toLowerCase();
const paid = entry.pricing === 'pay-as-you-go';
// The same three rows on every card: what you need, what you get (size) or what it costs, and the terms.
const props: [key: string, value: string, warn?: boolean][] = [
  ['access', signupShort(entry), paid],
  entry.sizeMB !== undefined ? ['size', sizeLabel(entry)] : ['cost', PRICING[entry.pricing].short, paid],
  ['license', entry.license],
];
// The access row already says whether you need a key or a card, so the card keeps the next two
// badges in BADGES order (commercial use, laptop fit, then the softer ones). The page shows all.
const badges = badgeList(entry).filter((b) => b.id !== 'no-signup' && b.id !== 'no-card').slice(0, 2);
const partial = entry.verification.status === 'partial';
---
<article
  class="entry-card group relative flex min-w-0 flex-col rounded-xl border border-slate-200 bg-panel transition-colors hover:border-brand-400"
  data-name={entry.name.toLowerCase()}
  data-search={search}
  data-kind={entry.kind}
  data-category={entry.category}
  data-badges={entry.badges.join(' ')}
  data-badge-count={entry.badges.length}
  data-size={entry.sizeMB ?? ''}
>
  <div class="flex items-center justify-between gap-2 border-b border-slate-200 px-4 py-2 text-xs">
    <span class:list={['font-semibold', entry.kind === 'api' ? 'text-syn-kw' : 'text-syn-str']}>{entry.kind === 'api' ? 'api' : 'dataset'}</span>
    <span class="truncate text-slate-500">{entry.category}/{entry.slug}</span>
  </div>
  <div class="flex flex-1 flex-col p-4">
    <h3 class="text-base font-bold text-slate-900">
      <a href={entryPath(entry)} class="after:absolute after:inset-0 group-hover:text-brand-700">{entry.name}</a>
    </h3>
    <p class="mt-1.5 text-[13px] leading-relaxed text-slate-600">{entry.summary}</p>
    <dl class="mt-4 space-y-1 text-xs">
      {props.map(([k, v, warn]) => (
        <div class="flex gap-2">
          <dt class="w-16 shrink-0 text-syn-prop">{k}</dt>
          <dd class:list={['truncate', warn ? 'font-medium text-amber-800' : 'text-slate-700']} title={v}>{v}</dd>
        </div>
      ))}
    </dl>
    {(badges.length > 0 || partial) && (
      <div class="mt-auto flex flex-wrap items-center gap-1.5 pt-4">
        {badges.map((b) => <Badge badge={b} />)}
        {partial && <span class="text-[11px] text-amber-800" title="Some details could not be confirmed against a primary source. The resource page says which.">Partly verified</span>}
      </div>
    )}
  </div>
</article>
