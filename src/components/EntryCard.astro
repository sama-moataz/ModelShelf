---
import ArrowRight from 'lucide-astro/ArrowRight';
import Database from 'lucide-astro/Database';
import Plug from 'lucide-astro/Plug';
import Badge from './Badge.astro';
import VerifiedBadge from './VerifiedBadge.astro';
import type { Entry } from '../data/directoryData';
import { accessLabel, badgeList, categoryById, entryPath, formatSize } from '../utils/format';

interface Props { entry: Entry }
const { entry } = Astro.props;
const Icon = entry.kind === 'api' ? Plug : Database;
const search = [entry.name, entry.summary, entry.provider, entry.license, ...entry.tags].join(' ').toLowerCase();
---
<article
  class="entry-card group relative flex flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
  data-name={entry.name.toLowerCase()}
  data-search={search}
  data-kind={entry.kind}
  data-category={entry.category}
  data-badges={entry.badges.join(' ')}
  data-badge-count={entry.badges.length}
  data-size={entry.sizeMB ?? ''}
>
  <div class="flex items-center gap-2 text-xs font-medium text-slate-500">
    <span class="grid h-7 w-7 place-items-center rounded-md bg-brand-50 text-brand-700"><Icon size={15} aria-hidden="true" /></span>
    <span class="uppercase tracking-wide">{entry.kind === 'api' ? 'API' : 'Dataset'}</span>
    <span aria-hidden="true">·</span>
    <span>{categoryById(entry.category).short}</span>
  </div>
  <h3 class="mt-3 text-lg font-semibold text-slate-900">
    <a href={entryPath(entry)} class="after:absolute after:inset-0 hover:text-brand-700">{entry.name}</a>
  </h3>
  <p class="mt-1 text-sm leading-relaxed text-slate-600">{entry.summary}</p>
  <div class="mt-3 flex flex-wrap gap-1.5">
    {badgeList(entry).slice(0, 4).map((b) => <Badge badge={b} />)}
  </div>
  <dl class="mt-4 grid grid-cols-2 gap-2 border-t border-slate-100 pt-3 text-xs text-slate-500">
    <div><dt class="font-medium text-slate-700">License</dt><dd class="truncate" title={entry.license}>{entry.license}</dd></div>
    <div><dt class="font-medium text-slate-700">{entry.sizeMB !== undefined ? 'Size' : 'Access'}</dt><dd>{entry.sizeMB !== undefined ? formatSize(entry.sizeMB) : accessLabel[entry.access]}</dd></div>
  </dl>
  <div class="mt-auto flex flex-wrap items-center justify-between gap-2 pt-3">
    <span class="inline-flex items-center gap-1 text-sm font-medium text-brand-700">View details <ArrowRight size={14} aria-hidden="true" class="transition group-hover:translate-x-0.5" /></span>
    <VerifiedBadge compact />
  </div>
</article>
