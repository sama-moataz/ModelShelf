---
// One "Dataset + Live API" project idea: the pair, then labelled rows an answer engine can quote.
import Database from 'lucide-astro/Database';
import Radio from 'lucide-astro/Radio';
import Plus from 'lucide-astro/Plus';
import { comboEntries, type ComboIdea } from '../data/guides';
import { entryPath, richText } from '../utils/format';

interface Props {
  combo: ComboIdea;
  level?: 2 | 3;
}
const { combo, level = 3 } = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
const { dataset, api } = comboEntries(combo);
const rows: [string, string][] = [
  ['You build', combo.build],
  ['How', combo.how],
  ['Hardware', combo.hardware],
  ['License', combo.license],
];
---
<article id={`combo-${combo.id}`} aria-labelledby={`combo-${combo.id}-h`} class="flex flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <H id={`combo-${combo.id}-h`} class="text-base font-bold leading-snug text-slate-900">{combo.title}</H>
  <p class="mt-3 flex flex-wrap items-center gap-1.5 text-sm">
    <span class="sr-only">Dataset:</span>
    <a href={entryPath(dataset)} class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-2.5 py-1 font-medium text-brand-700 ring-1 ring-inset ring-brand-100 hover:underline"><Database size={13} aria-hidden="true" />{dataset.name}</a>
    <Plus size={14} aria-hidden="true" class="text-slate-400" />
    <span class="sr-only">plus live API:</span>
    <a href={entryPath(api)} class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 font-medium text-emerald-800 ring-1 ring-inset ring-emerald-600/20 hover:underline"><Radio size={13} aria-hidden="true" />{api.name}</a>
  </p>
  <dl class="mt-4 space-y-3 text-sm leading-relaxed">
    {rows.map(([k, v]) => (
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">{k}</dt>
        <dd class="mt-0.5 text-slate-700" set:html={richText(v)} />
      </div>
    ))}
  </dl>
</article>
