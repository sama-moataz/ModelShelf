---
// Shared template for programmatic hubs (/hardware/*, /access/*).
import Layout from '../layouts/Layout.astro';
import EntryCard from './EntryCard.astro';
import PageHeader from './PageHeader.astro';
import { SITE_NAME } from '../config/site';
import { hubEntries, type Hub } from '../data/hubs';
import { hubAnswer } from '../data/guides';
import { WEBSITE_ID, breadcrumbs, itemList, abs } from '../utils/seo';

interface Props {
  hub: Hub;
  section: { base: string; name: string };
  siblings: Hub[];
}
const { hub, section, siblings } = Astro.props;
const list = hubEntries(hub);
const groups = [
  { title: 'Datasets', items: list.filter((e) => e.kind === 'dataset') },
  { title: 'APIs', items: list.filter((e) => e.kind === 'api') },
].filter((g) => g.items.length);
const path = `${section.base}${hub.slug}/`;
const trail: [string, string][] = [[SITE_NAME, '/'], [section.name, section.base], [hub.label, path]];
const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: hub.title,
    description: hub.metaDescription,
    url: abs(path),
    isPartOf: { '@type': 'WebSite', '@id': WEBSITE_ID, name: SITE_NAME, url: abs('/') },
    mainEntity: itemList(hub.title, list),
  },
  breadcrumbs(trail),
];
---
<Layout title={hub.title} description={hub.metaDescription} jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:py-12">
    <PageHeader trail={trail} title={hub.title} lead={hubAnswer(hub)}>
      <p class="mt-3 max-w-3xl leading-relaxed text-slate-600">{hub.intro}</p>
    </PageHeader>

    {groups.map((g) => (
      <section class="mt-10" aria-labelledby={`g-${g.title}`}>
        <h2 id={`g-${g.title}`} class="section-title">{g.title} <span class="text-base font-normal text-slate-500">({g.items.length})</span></h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{g.items.map((e) => <EntryCard entry={e} />)}</div>
      </section>
    ))}

    <section class="mt-12 max-w-3xl" aria-labelledby="guide">
      <h2 id="guide" class="section-title">{hub.guideHeading}</h2>
      {hub.guide.map((p) => <p class="mt-4 leading-relaxed text-slate-700">{p}</p>)}
    </section>

    <nav class="mt-12 border-t border-slate-200 pt-6 text-sm" aria-labelledby="more-hubs">
      <h2 id="more-hubs" class="text-sm text-slate-500">More <a class="hover:text-brand-700" href={section.base}>{section.name.toLowerCase()} collections</a></h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {siblings.filter((s) => s.slug !== hub.slug).map((s) => <li><a class="chip-link" href={`${section.base}${s.slug}/`}>{s.label} ({hubEntries(s).length})</a></li>)}
        <li><a class="chip-link" href="/compare/">Compare all resources</a></li>
      </ul>
    </nav>
  </div>
</Layout>
