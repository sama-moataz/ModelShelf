---
import BadgeCheck from 'lucide-astro/BadgeCheck';
import { LAST_CHECKED, entries } from '../data/directoryData';
import { REPO_URL, SITE_NAME } from '../config/site';

const datasetCount = entries.filter((e) => e.kind === 'dataset').length;
// The header's Browse menu already lists every category, hub and landing page, so the footer
// links only to the section overviews and the site's own pages.
const links: [label: string, href: string][] = [
  ['Categories', '/categories/'],
  ['By hardware', '/hardware/'],
  ['By access', '/access/'],
  ['Guides', '/guides/'],
  ['Comparison table', '/compare/'],
  ['Free-tier estimator', '/estimator/'],
  ['About & methodology', '/about/'],
  ['Suggest a resource', '/submit/'],
  ['Source on GitHub', REPO_URL],
];
---
<footer class="mt-20 border-t border-slate-200 bg-panel">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-8 md:flex-row md:justify-between md:gap-12">
    <div class="max-w-sm">
      <p class="text-lg font-bold text-slate-900">{SITE_NAME}</p>
      <p class="mt-2 text-sm leading-relaxed text-slate-600">Curated open datasets and APIs for student and indie AI/ML projects. Free to use, no ads, no cookies. Every entry is checked against its primary sources: <a class="link" href="/about/#verified">how entries are verified</a>.</p>
    </div>
    <nav aria-label="Footer">
      <ul class="grid grid-cols-2 gap-x-8 text-sm sm:grid-cols-3">
        {links.map(([label, href]) => (
          <li><a class="inline-block py-1 text-slate-600 hover:text-brand-700" href={href} rel={href.startsWith('http') ? 'noopener' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  {/* Editor-style status bar: every segment is a real fact or a real link. */}
  <div class="border-t border-slate-200 bg-slate-50 text-xs text-slate-500">
    <div class="mx-auto flex max-w-6xl flex-wrap items-stretch px-4">
      <span class="flex items-center gap-1.5 border-r border-slate-200 py-1.5 pr-3 text-syn-str"><BadgeCheck size={12} aria-hidden="true" /> verified <time class="text-slate-600" datetime={LAST_CHECKED}>{LAST_CHECKED}</time></span>
      <span class="border-r border-slate-200 px-3 py-1.5"><span class="text-syn-num">{datasetCount}</span> datasets</span>
      <span class="border-r border-slate-200 px-3 py-1.5"><span class="text-syn-num">{entries.length - datasetCount}</span> APIs</span>
      <span class="ml-auto flex">
        <a class="px-3 py-1.5 hover:bg-slate-100 hover:text-slate-900" href="/sitemap-index.xml">sitemap</a>
        <a class="px-3 py-1.5 hover:bg-slate-100 hover:text-slate-900" href="/robots.txt">robots.txt</a>
        <a class="py-1.5 pl-3 hover:text-slate-900" href="/llms.txt">llms.txt</a>
      </span>
    </div>
  </div>
</footer>
