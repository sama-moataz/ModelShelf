---
import BadgeCheck from 'lucide-astro/BadgeCheck';
import { CATEGORIES, LAST_CHECKED, entries } from '../data/directoryData';
import { LANDINGS } from '../data/landings';
import { ACCESS_HUBS, HARDWARE_HUBS } from '../data/hubs';
import { REPO_URL, SITE_NAME } from '../config/site';

const datasetCount = entries.filter((e) => e.kind === 'dataset').length;
---
<footer class="mt-20 border-t border-slate-200 bg-panel">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-2 lg:grid-cols-6">
    <div class="sm:col-span-2 lg:col-span-1">
      <p class="text-lg font-bold text-slate-900">{SITE_NAME}</p>
      <p class="mt-2 text-sm leading-relaxed text-slate-600">Curated open datasets and APIs for student and indie AI/ML projects. Free to use, no ads, no cookies.</p>
      <p class="mt-3 text-sm leading-relaxed text-slate-600">Every entry is checked against its primary sources. <a class="link" href="/about/#verified">How entries are verified</a></p>
    </div>
    <nav aria-label="Start here">
      <p class="text-sm font-semibold text-slate-900">Start here</p>
      <ul class="mt-2 text-sm">
        {LANDINGS.map((l) => <li><a class="inline-block py-1 text-slate-600 hover:text-brand-700" href={`/${l.slug}/`}>{l.label}</a></li>)}
        <li><a class="inline-block py-1 text-slate-600 hover:text-brand-700" href="/guides/">Guides</a></li>
      </ul>
    </nav>
    <nav aria-label="Categories">
      <p class="text-sm font-semibold text-slate-900">Categories</p>
      <ul class="mt-2 text-sm">
        {CATEGORIES.map((c) => <li><a class="inline-block py-1 text-slate-600 hover:text-brand-700" href={`/categories/${c.id}/`}>{c.name}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Hardware">
      <p class="text-sm font-semibold text-slate-900"><a class="hover:text-brand-700" href="/hardware/">By hardware</a></p>
      <ul class="mt-2 text-sm">
        {HARDWARE_HUBS.map((h) => <li><a class="inline-block py-1 text-slate-600 hover:text-brand-700" href={`/hardware/${h.slug}/`}>{h.label}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Access">
      <p class="text-sm font-semibold text-slate-900"><a class="hover:text-brand-700" href="/access/">By access</a></p>
      <ul class="mt-2 text-sm">
        {ACCESS_HUBS.map((h) => <li><a class="inline-block py-1 text-slate-600 hover:text-brand-700" href={`/access/${h.slug}/`}>{h.label}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="More">
      <p class="text-sm font-semibold text-slate-900">More</p>
      <ul class="mt-2 text-sm">
        <li><a class="inline-block py-1 text-slate-600 hover:text-brand-700" href="/compare/">Compare all resources</a></li>
        <li><a class="inline-block py-1 text-slate-600 hover:text-brand-700" href="/about/">About &amp; verification</a></li>
        <li><a class="inline-block py-1 text-slate-600 hover:text-brand-700" href="/estimator/">Free-tier estimator</a></li>
        <li><a class="inline-block py-1 text-slate-600 hover:text-brand-700" href="/submit/">Suggest a resource</a></li>
        <li><a class="inline-block py-1 text-slate-600 hover:text-brand-700" href={REPO_URL} rel="noopener">Source on GitHub</a></li>
      </ul>
    </nav>
  </div>
  {/* Editor-style status bar: every segment is a real fact or a real link. */}
  <div class="border-t border-slate-200 bg-slate-50 text-xs text-slate-500">
    <div class="mx-auto flex max-w-6xl flex-wrap items-stretch px-4">
      <span class="flex items-center gap-1.5 border-r border-slate-200 py-1.5 pr-3 text-syn-str"><BadgeCheck size={12} aria-hidden="true" /> verified <time class="text-slate-600" datetime={LAST_CHECKED}>{LAST_CHECKED}</time></span>
      <span class="border-r border-slate-200 px-3 py-1.5"><span class="text-syn-num">{datasetCount}</span> datasets</span>
      <span class="border-r border-slate-200 px-3 py-1.5"><span class="text-syn-num">{entries.length - datasetCount}</span> APIs</span>
      <span class="ml-auto flex">
        <a class="px-3 py-1.5 hover:bg-slate-100 hover:text-slate-900" href="/sitemap-index.xml">sitemap</a>
        <a class="px-3 py-1.5 hover:bg-slate-100 hover:text-slate-900" href="/robots.txt">robots.txt</a>
        <a class="py-1.5 pl-3 hover:text-slate-900" href="/llms.txt">llms.txt</a>
      </span>
    </div>
  </div>
</footer>
